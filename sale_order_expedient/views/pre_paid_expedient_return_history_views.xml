<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pre_paid_expedient_return_history_form" model="ir.ui.view">
        <field name="name">pre.paid.expedient.return.history.form</field>
        <field name="model">pre.paid.expedient.return.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="return_date"/>
                            <field name="return_reason_id" options="{'no_create': True}"/>
                            <field name="user_id" widget="many2one_avatar" readonly="1"/>
                        </group>
                        <group>
                            <field name="pre_paid_expedient_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
</odoo>
