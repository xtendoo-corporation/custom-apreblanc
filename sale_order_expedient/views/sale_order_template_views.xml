<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit from sale.order.template form view to add partner_id field -->
    <record id="view_sale_order_template_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.template.form.inherit</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <data>
                <!-- Remove the old position of partner_id field -->
                <field name="company_id" position="after">
                    <!-- This line is empty because we're moving the field elsewhere -->
                </field>

                <!-- Position partner_id and allowed_user_ids fields after the title -->
                <xpath expr="//div[hasclass('oe_title')]" position="after">
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}" string="Cliente"/>
                        </group>
                        <group>
                            <field name="allowed_user_ids" widget="many2many_tags"
                                   placeholder="Leave empty to allow all users"/>
                        </group>
                    </group>
                </xpath>

                <!-- Fix for Odoo 17: Use xpath to find sheet and add button at the top -->
                <xpath expr="//sheet" position="inside">
                    <div class="oe_button_box" name="button_box" style="margin-top: 10px;" invisible="id == False">
                        <!-- Fix: Reference the existing action instead of the missing one -->
                        <button name="%(sale_order_expedient.action_create_new_expedient)d"
                                type="action"
                                string="Create Expedient"
                                class="btn-primary"
                                context="{'default_sale_order_template_id': active_id}"/>
                    </div>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
