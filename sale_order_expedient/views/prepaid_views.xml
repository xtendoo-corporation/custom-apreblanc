<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for the expedient creation wizard -->
    <record id="view_expedient_create_wizard_form" model="ir.ui.view">
        <field name="name">expedient.create.wizard.form</field>
        <field name="model">expedient.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Expedient">
                <sheet>
                    <group>
                        <!-- Ocultar el campo de tipo de expediente ya que viene del contexto -->
                        <field name="expedient_type" invisible="1"/>
                    </group>

                    <group>
                        <group>
                            <field name="sale_order_template_id"/>
                            <field name="partner_id" required="1"/>
                            <field name="client_id" required="1"/>
                            <field name="expedient_number" required="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Create" name="action_create_expedient" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_create_new_expedient" model="ir.actions.act_window">
        <field name="name">Create Expedient</field>
        <field name="res_model">expedient.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_expedient_create_wizard_form"/>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="binding_view_types">form,list</field>
    </record>
</odoo>
