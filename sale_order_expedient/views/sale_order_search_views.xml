<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de búsqueda para expedientes post-pagados -->
    <record id="view_sale_order_expedient_search" model="ir.ui.view">
        <field name="name">sale.order.expedient.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Buscar Expedientes Post-pagados">
                <!-- Campos estándar de Sale Order -->
                <field name="name" string="Pedido" filter_domain="[('name','ilike',self)]"/>
                <field name="partner_id" operator="child_of"/>
                <field name="user_id"/>
                <field name="order_line" string="Producto" filter_domain="[('order_line.product_id', 'ilike', self)]"/>

                <!-- Campos específicos de expediente -->
                <field name="client_id"/>
                <field name="expedient_number"/>

                <!-- Filtros -->
                <filter string="Mis Expedientes Post-pagados" name="my_expedients" domain="[('expedient_manager_id', '=', uid)]" help="Mostrar solo mis expedientes post-pagados"/>
                <filter string="Todos los Expedientes Post-pagados" name="all_expedients" domain="[('expedient_type', '=', 'post_paid')]" help="Mostrar todos los expedientes post-pagados"/>
                <separator/>
                <filter string="Expedientes Post-pagados" name="expedient_filter" domain="[('expedient_type', '!=', 'none')]"/>
                <separator/>
                <filter string="Created or Pending" name="expedient_state_active"
                       domain="[('expedient_state', 'in', ['creada', 'pendiente_documentacion'])]"/>
                <separator/>
                <filter string="Created" name="expedient_state_creada" domain="[('expedient_state', '=', 'creada')]"/>
                <filter string="Pending Documentation" name="expedient_state_pendiente" domain="[('expedient_state', '=', 'pendiente_documentacion')]"/>
                <filter string="Approved" name="expedient_state_aprobada" domain="[('expedient_state', '=', 'aprobada')]"/>
                <filter string="Rejected" name="expedient_state_rechazada" domain="[('expedient_state', '=', 'rechazada')]"/>
                <filter string="Canceled" name="expedient_state_cancelada" domain="[('expedient_state', '=', 'cancelada')]"/>

                <!-- Agrupar Por -->
                <group expand="0" string="Agrupar Por">
                    <filter string="Vendedor" name="salesperson" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Cliente" name="customer" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="ID de Cliente" name="client" domain="[]" context="{'group_by': 'client_id'}"/>
                    <filter string="Estado del Expediente" name="expedient_state_group" domain="[]" context="{'group_by': 'expedient_state'}"/>
                    <filter string="Fecha de Pedido" name="order_month" domain="[]" context="{'group_by': 'date_order'}"/>
                    <filter string="Estado" name="status" domain="[]" context="{'group_by': 'state'}"/>
                </group>
                <searchpanel>
                    <field name="expedient_state" string="Estado" icon="fa-info-circle"/>
                    <field name="expedient_manager_id" string="Responsable" icon="fa-user"/>
                </searchpanel>
            </search>
        </field>
    </record>
</odoo>
