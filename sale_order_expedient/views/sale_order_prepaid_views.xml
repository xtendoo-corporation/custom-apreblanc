<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Tree para Expedientes Pre-pagados (siempre son pedidos de venta) -->
        <record id="view_sale_order_prepaid_tree" model="ir.ui.view">
            <field name="name">sale.order.prepaid.tree</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <tree string="Pedidos de Venta Pre-pagados">
                    <!-- Nota: Cambiado de "Expedientes Pre-pagados" a "Pedidos de Venta Pre-pagados" -->
                    <field name="partner_id"/>
                    <field name="client_id"/>
                    <field name="expedient_number"/>
                    <field name="name"/>
                    <field name="pre_paid_expedient_id"/>
                    <field name="date_order" string="Fecha de Inicio"/>
                </tree>
            </field>
        </record>

        <!-- Acción para Expedientes Pre-pagados -->
        <record id="action_sale_order_prepaid" model="ir.actions.act_window">
            <field name="name">Pedidos de Venta Pre-pagados</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_sale_order_prepaid_tree"/>
            <field name="domain">[('expedient_type', '=', 'pre_paid')]</field>
            <field name="context">{
                'default_expedient_type': 'pre_paid',
                'search_default_expedient_state_active': 1,
                'show_as_expedient': True
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear un nuevo pedido de venta pre-pagado
                </p>
                <p>
                    <b>IMPORTANTE:</b> Los expedientes pre-pagados se convierten automáticamente en
                    pedidos de venta confirmados al crearse. No pasan por la fase de presupuesto.
                </p>
            </field>
        </record>

        <!-- Menú para Expedientes Pre-pagados -->
        <menuitem id="menu_sale_order_prepaid"
                  name="Pedidos de Venta Pre-pagados"
                  parent="sale.sale_order_menu"
                  action="action_sale_order_prepaid"
                  sequence="25"/>
    </data>
</odoo>
