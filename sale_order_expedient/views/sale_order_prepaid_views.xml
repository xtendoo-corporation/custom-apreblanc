<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree para Expedientes Pre-pagados -->
    <record id="view_sale_order_prepaid_tree" model="ir.ui.view">
        <field name="name">sale.order.prepaid.tree</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <tree string="Expedientes Pre-pagados">
                <control>
                    <create string="Nuevo Expediente Pre-pagado" context="{'default_expedient_type': 'pre_paid'}"/>
                    <button string="Crear Expediente Pre-pagado" name="%(action_create_new_expedient)d" type="action"
                            context="{'default_expedient_type': 'pre_paid'}" class="btn-primary"/>
                </control>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="pre_paid_expedient_id"/>
                <field name="client_id"/>
                <field name="expedient_number"/>
                <field name="expedient_date"/>
                <field name="expedient_date_end"/>
                <field name="expedient_resolution_time" optional="show"/>
                <field name="expedient_manager_id"/>
                <field name="return_count" string="Devoluciones"/>
                <field name="expedient_state" widget="badge"
                       decoration-info="expedient_state=='creada'"
                       decoration-warning="expedient_state=='pendiente_documentacion'"
                       decoration-success="expedient_state=='aprobada'"
                       decoration-danger="expedient_state=='rechazada'"
                       decoration-muted="expedient_state=='cancelada'"/>
            </tree>
        </field>
    </record>

    <!-- Acción para Expedientes Pre-pagados -->
    <record id="action_sale_order_prepaid" model="ir.actions.act_window">
        <field name="name">Expedientes Pre-pagados</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_sale_order_prepaid_tree"/>
        <field name="domain">[('expedient_type', '=', 'pre_paid')]</field>
        <field name="context">{
            'default_expedient_type': 'pre_paid',
            'search_default_expedient_type': 'pre_paid',
            'show_as_expedient': True
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo expediente pre-pagado
            </p>
            <p>
                Los expedientes pre-pagados se confirman automáticamente como órdenes de venta
                y están vinculados a expedientes prepagados existentes con saldo disponible.
            </p>
        </field>
    </record>

    <!-- Agregar acción para crear expedientes prepagados desde el wizard -->
    <record id="action_create_prepaid_expedient_wizard" model="ir.actions.act_window">
        <field name="name">Crear Expediente Pre-pagado</field>
        <field name="res_model">expedient.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_expedient_type': 'pre_paid'}</field>
    </record>

    <!-- Elemento de menú para Expedientes Pre-pagados -->
    <menuitem id="menu_sale_order_prepaid"
              name="Expedientes Pre-pagados"
              parent="sale.sale_order_menu"
              action="action_sale_order_prepaid"
              sequence="25"/>
</odoo>
