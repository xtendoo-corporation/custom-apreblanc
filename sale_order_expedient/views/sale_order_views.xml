<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista tree para expedientes -->
    <record id="view_sale_order_expedient_tree" model="ir.ui.view">
        <field name="name">sale.order.expedient.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="is_expedient" invisible="1"/>
                <field name="expedient_number" optional="show"/>
                <field name="client_id" optional="show"/>
                <field name="expedient_state" optional="show"
                       decoration-info="expedient_state == 'creada'"
                       decoration-success="expedient_state == 'aprobada'"
                       decoration-danger="expedient_state == 'rechazada'"
                       decoration-muted="expedient_state == 'cancelada'"
                       decoration-warning="expedient_state == 'pendiente_documentacion'"/>
                <field name="expedient_deadline" optional="show"/>
                <field name="return_count" optional="show" sum="Total Returns"/>
            </field>
        </field>
    </record>

    <!-- Update the form view to make closed expedients readonly -->
    <record id="view_order_form_expedient" model="ir.ui.view">
        <field name="name">sale.order.form.expedient</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add is_expedient and expedient_state fields -->
            <field name="partner_id" position="after">
                <field name="is_expedient" invisible="1"/>
                <field name="expedient_state" invisible="1"/>
                <field name="locked" invisible="1"/>
            </field>

            <!-- Make standard fields readonly when expedient is closed -->
            <field name="partner_id" position="attributes">
                <attribute name="readonly">is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </field>

            <field name="validity_date" position="attributes">
                <attribute name="readonly">is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </field>

            <field name="date_order" position="attributes">
                <attribute name="readonly">is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </field>

            <field name="payment_term_id" position="attributes">
                <attribute name="readonly">is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </field>

            <field name="pricelist_id" position="attributes">
                <attribute name="readonly">is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </field>

            <field name="fiscal_position_id" position="attributes">
                <attribute name="readonly">is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </field>

            <!-- Fix for Odoo 17.0 - Targeting header buttons with proper attributes -->
            <xpath expr="//header/button[@name='action_confirm']" position="attributes">
                <attribute name="invisible" add="is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')" separator=" or "/>
            </xpath>

            <xpath expr="//header/button[@name='action_quotation_send']" position="attributes">
                <attribute name="invisible" add="is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')" separator=" or "/>
            </xpath>

            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible" add="is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')" separator=" or "/>
            </xpath>

            <!-- Add a warning banner for closed expedients -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning text-center" role="alert"
                     invisible="not is_expedient or expedient_state not in ('aprobada', 'rechazada', 'cancelada')">
                    This expedient is closed and cannot be modified.
                </div>
            </xpath>

            <!-- Statusbar remains clickable to allow state changes -->
            <xpath expr="//sheet" position="inside">
                <div class="position-absolute top-0 end-0 mt-3 me-3" invisible="not is_expedient">
                    <field name="expedient_state"
                           widget="statusbar"
                           statusbar_visible="creada,pendiente_documentacion,aprobada,rechazada,cancelada"
                           clickable="True"
                           options="{'clickable': '1'}"
                           class="expedient_statusbar"
                           nolabel="1"/>
                </div>
            </xpath>

            <!-- Mover información de expediente al formulario principal -->
            <xpath expr="//group[1]" position="after">
                <!-- Use standard Odoo attributes for readonly states -->
                <group name="expedient_info" string="Expedient Information"
                       invisible="not is_expedient">
                    <group>
                        <!-- In Odoo 17, readonly is a direct attribute in field tags -->
                        <field name="expedient_number" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                        <field name="client_id" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                        <field name="expedient_date" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                        <field name="expedient_deadline" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                    </group>
                    <group>
                        <field name="expedient_manager_id" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                        <field name="expedient_notes" placeholder="Add notes about this expedient..." readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                    </group>
                </group>
            </xpath>

            <!-- Update Returns page -->
            <xpath expr="//notebook/page[1]" position="before">
                <page name="returns" string="Returns" invisible="not is_expedient">
                    <field name="expedient_return_history_ids"
                           context="{'default_user_id': uid, 'form_view_ref': 'sale_order_expedient.view_expedient_return_history_form'}"
                           readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"
                           style="min-height: 400px; width: 100%;">
                        <tree editable="bottom"
                              create="expedient_state not in ('aprobada', 'rechazada', 'cancelada')"
                              delete="expedient_state not in ('aprobada', 'rechazada', 'cancelada')">
                            <field name="return_date" readonly="0"/>
                            <field name="return_reason_id" options="{'no_create': True}" required="1"/>
                            <field name="notes"/>
                            <field name="user_id" widget="many2one_avatar" force_save="1" readonly="1"/>
                        </tree>
                    </field>
                </page>
            </xpath>

            <!-- Make order lines readonly when expedient is closed -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </xpath>

            <!-- Disable create/delete in order lines tree view when expedient is closed -->
            <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="create">not is_expedient or expedient_state not in ('aprobada', 'rechazada', 'cancelada')</attribute>
                <attribute name="delete">not is_expedient or expedient_state not in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </xpath>

            <!-- Make individual fields in order line form view readonly when expedient is closed -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="readonly">parent.is_expedient and parent.expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly">parent.is_expedient and parent.expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">parent.is_expedient and parent.expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </xpath>
        </field>
    </record>

    <!-- Create a specific tree view for the history records with better formatting -->
    <record id="view_expedient_return_history_tree" model="ir.ui.view">
        <field name="name">sale.order.expedient.return.history.tree</field>
        <field name="model">sale.order.expedient.return.history</field>
        <field name="arch" type="xml">
            <tree decoration-info="1" editable="bottom" create="true">
                <field name="return_date"/>
                <field name="return_reason_id" options="{'no_create': True}"/>
                <field name="notes"/>
                <field name="user_id" widget="many2one_avatar" readonly="1"/>
            </tree>
        </field>
    </record>

    <!-- Form view for return history with chatter -->
    <record id="view_expedient_return_history_form" model="ir.ui.view">
        <field name="name">sale.order.expedient.return.history.form</field>
        <field name="model">sale.order.expedient.return.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="return_date"/>
                            <field name="return_reason_id" options="{'no_create': True}"/>
                            <field name="user_id" widget="many2one_avatar" readonly="1"/>
                        </group>
                        <group>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista específica para expedientes con botón al lado de la barra de búsqueda -->
    <record id="view_expedient_tree_custom" model="ir.ui.view">
        <field name="name">sale.order.expedient.tree.custom</field>
        <field name="model">sale.order</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree string="Expedientes">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="expedient_number"/>
                <field name="client_id"/>
                <field name="expedient_state" widget="badge"
                       decoration-info="expedient_state == 'creada'"
                       decoration-success="expedient_state == 'aprobada'"
                       decoration-danger="expedient_state == 'rechazada'"
                       decoration-muted="expedient_state == 'cancelada'"
                       decoration-warning="expedient_state == 'pendiente_documentacion'"/>
                <field name="expedient_deadline"/>
                <field name="return_count" sum="Total Returns"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- REMOVE OR COMMENT OUT this action definition - we'll use the one from wizards/expedient_wizard_views.xml -->
    <!--
    <record id="sale_order_expedient_action_wizard" model="ir.actions.act_window">
        <field name="name">Wizard Expediente</field>
        <field name="res_model">expedient.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
    </record>
    -->

    <!-- Actualizar la acción para expedientes -->
    <record id="action_sale_order_expedient" model="ir.actions.act_window">
        <field name="name">Expedientes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_expedient_tree_custom"/>
        <field name="domain">[('is_expedient', '=', True)]</field>
        <field name="context">{'default_is_expedient': True, 'search_default_is_expedient': True}</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo expediente
            </p>
        </field>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="binding_type">action</field>
    </record>

    <!-- Add action button for wizard -->
    <record id="action_button_create_expedient_wizard" model="ir.actions.server">
        <field name="name">Wizard</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'name': 'Crear Expediente',
                'res_model': 'expedient.create.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': env.context,
            }
        </field>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Vista tree para expedientes (asegurar que se utiliza esta vista) -->
    <record id="action_expedient_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_expedient_tree_custom"/>
        <field name="act_window_id" ref="action_sale_order_expedient"/>
    </record>

    <!-- Vista form para expedientes (secuencia mayor para que se muestre después) -->
    <record id="action_expedient_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_order_form_expedient"/>
        <field name="act_window_id" ref="action_sale_order_expedient"/>
    </record>

    <!-- Menú para expedientes con la acción configurada -->
    <menuitem id="menu_sale_order_expedient"
              name="Expedientes"
              parent="sale.sale_order_menu"
              action="action_sale_order_expedient"
              sequence="25"/>

    <!-- Update to use the action from the wizard views -->
    <menuitem id="menu_create_expedient"
              name="Nuevo Expediente"
              parent="sale.sale_order_menu"
              action="action_create_new_expedient"
              sequence="26"/>
</odoo>
