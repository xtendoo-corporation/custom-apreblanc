    <!-- Vista simple para ocultar la pestaña de líneas de pedido -->
    <record id="view_order_form_hide_order_lines" model="ir.ui.view">
        <field name="name">sale.order.form.hide.order.lines</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Asegurar que el campo expedient_type está disponible -->
            <form position="inside">
                <field name="expedient_type" invisible="1"/>
            </form>

            <!-- Ocultar líneas de pedido cuando se accede desde vistas de expedientes (show_as_expedient = True) -->
            <!-- Solo mostrar cuando NO hay contexto show_as_expedient (vistas normales de presupuestos) -->
            <xpath expr="//page[@name='order_lines']" position="attributes">
                <attribute name="invisible">context.get('show_as_expedient', False)</attribute>
            </xpath>
        </field>
    </record>
</odoo>
