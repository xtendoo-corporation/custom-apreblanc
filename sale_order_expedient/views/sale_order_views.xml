<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista tree para expedientes -->
    <record id="view_sale_order_expedient_tree" model="ir.ui.view">
        <field name="name">sale.order.expedient.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="is_expedient" optional="show"/>
                <field name="expedient_number" optional="show"/>
                <field name="expedient_state" optional="show"
                       decoration-info="expedient_state == 'draft'"
                       decoration-warning="expedient_state == 'pending'"
                       decoration-success="expedient_state == 'done'"
                       decoration-danger="expedient_state == 'cancelled'"/>
                <field name="expedient_deadline" optional="show"/>
                <field name="expedient_return_date" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Añadir campos de expediente a la vista form -->
    <record id="view_order_form_expedient" model="ir.ui.view">
        <field name="name">sale.order.form.expedient</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="is_expedient"/>
            </field>

            <notebook position="inside">
                <page string="Información del Expediente" invisible="not is_expedient">
                    <header>
                        <button name="action_expedient_draft" type="object" string="Borrador"
                                class="btn btn-secondary" invisible="expedient_state == 'draft'"/>
                        <button name="action_expedient_in_progress" type="object" string="En Progreso"
                                class="btn btn-primary" invisible="expedient_state == 'in_progress'"/>
                        <button name="action_expedient_pending" type="object" string="Pendiente"
                                class="btn btn-warning" invisible="expedient_state == 'pending'"/>
                        <button name="action_expedient_done" type="object" string="Completado"
                                class="btn btn-success" invisible="expedient_state == 'done'"/>
                        <button name="action_expedient_cancelled" type="object" string="Cancelado"
                                class="btn btn-danger" invisible="expedient_state == 'cancelled'"/>
                        <field name="expedient_state" widget="statusbar" statusbar_visible="draft,in_progress,pending,done,cancelled"/>
                    </header>
                    <group>
                        <group>
                            <field name="expedient_number" readonly="1"/>
                            <field name="expedient_date"/>
                            <field name="expedient_deadline"/>
                        </group>
                        <group>
                            <field name="expedient_manager_id"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="expedient_notes" nolabel="1" placeholder="Añadir notas sobre este expediente..."/>
                    </group>
                </page>
                <page string="Devolución de Expediente" invisible="not is_expedient">
                    <header>
                        <button name="action_return_pending" type="object" string="Pendiente"
                                class="btn btn-secondary" invisible="expedient_return_state != 'pending'"/>
                        <button name="action_return_accepted" type="object" string="Aceptada"
                                class="btn btn-success" invisible="expedient_return_state == 'accepted'"/>
                        <button name="action_return_rejected" type="object" string="Rechazada"
                                class="btn btn-danger" invisible="expedient_return_state == 'rejected'"/>
                        <field name="expedient_return_state" widget="statusbar" statusbar_visible="pending,accepted,rejected"/>
                    </header>
                    <button name="register_expedient_return" string="Registrar Devolución" type="object"
                            class="oe_highlight" invisible="expedient_return_date != False"/>
                    <group>
                        <group>
                            <field name="expedient_return_date"/>
                            <field name="expedient_return_user_id"/>
                        </group>
                        <group>
                            <field name="expedient_return_reason"/>
                        </group>
                    </group>
                    <group string="Notas de Devolución">
                        <field name="expedient_return_notes" nolabel="1" placeholder="Añadir notas sobre la devolución..."/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Acción específica para crear expedientes con wizard -->
    <record id="action_create_new_expedient" model="ir.actions.act_window">
        <field name="name">Crear Expediente</field>
        <field name="res_model">expedient.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Vista específica para expedientes con botón al lado de la barra de búsqueda -->
    <record id="view_expedient_tree_custom" model="ir.ui.view">
        <field name="name">sale.order.expedient.tree.custom</field>
        <field name="model">sale.order</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree string="Expedientes" create="1" delete="1" edit="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="expedient_number"/>
                <field name="expedient_state" decoration-info="expedient_state == 'draft'"
                       decoration-warning="expedient_state == 'pending'"
                       decoration-success="expedient_state == 'done'"
                       decoration-danger="expedient_state == 'cancelled'"/>
                <field name="expedient_deadline"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
                <field name="is_expedient" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Agregar botón de acción directo en el menu de acción -->
    <record id="sale_order_expedient_action_wizard" model="ir.actions.act_window">
        <field name="name">Wizard Expediente</field>
        <field name="res_model">expedient.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- Actualizar la acción para expedientes -->
    <record id="action_sale_order_expedient" model="ir.actions.act_window">
        <field name="name">Expedientes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_expedient_tree_custom"/>
        <field name="domain">[('is_expedient', '=', True)]</field>
        <field name="context">{
            'default_is_expedient': True,
            'show_wizard_button': True
        }</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo expediente
            </p>
        </field>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="binding_type">action</field>
    </record>

    <!-- Add action button for wizard -->
    <record id="action_button_create_expedient_wizard" model="ir.actions.server">
        <field name="name">Wizard</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'name': 'Crear Expediente',
                'res_model': 'expedient.create.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': env.context,
            }
        </field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="binding_type">action</field>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Vista tree para expedientes (asegurar que se utiliza esta vista) -->
    <record id="action_expedient_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_expedient_tree_custom"/>
        <field name="act_window_id" ref="action_sale_order_expedient"/>
    </record>

    <!-- Vista form para expedientes (secuencia mayor para que se muestre después) -->
    <record id="action_expedient_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_order_form_expedient"/>
        <field name="act_window_id" ref="action_sale_order_expedient"/>
    </record>

    <!-- Menú para expedientes con la acción configurada -->
    <menuitem id="menu_sale_order_expedient"
              name="Expedientes"
              parent="sale.sale_order_menu"
              action="action_sale_order_expedient"
              sequence="25"/>

    <!-- Acción para crear directamente desde el menú -->
    <menuitem id="menu_create_expedient"
              name="Nuevo Expediente"
              parent="sale.sale_order_menu"
              action="action_create_new_expedient"
              sequence="26"/>
</odoo>
