<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista tree para expedientes -->
    <record id="view_sale_order_expedient_tree" model="ir.ui.view">
        <field name="name">sale.order.expedient.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="is_expedient" invisible="1"/>
                <field name="expedient_number" optional="show"/>
                <field name="client_id" optional="show"/>
                <field name="expedient_manager_id" optional="show"/>
                <field name="expedient_state" optional="show"
                       decoration-info="expedient_state == 'creada'"
                       decoration-success="expedient_state == 'aprobada'"
                       decoration-danger="expedient_state == 'rechazada'"
                       decoration-muted="expedient_state == 'cancelada'"
                       decoration-warning="expedient_state == 'pendiente_documentacion'"/>
                <field name="expedient_deadline" optional="show"/>
                <field name="return_count" optional="show" sum="Total Returns"/>
            </field>
        </field>
    </record>

    <!-- Update the form view to make closed expedients readonly -->
    <record id="view_order_form_expedient" model="ir.ui.view">
        <field name="name">sale.order.form.expedient</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add is_expedient and expedient_state fields -->
            <field name="partner_id" position="after">
                <field name="is_expedient" invisible="1"/>
                <field name="expedient_state" invisible="1"/>
                <field name="locked" invisible="1"/>
            </field>

            <!-- Remove problematic XPath expressions that target non-existent fields -->

            <!-- Only move specific fields that we know exist -->
            <xpath expr="//field[@name='validity_date']" position="replace"/>
            <xpath expr="//field[@name='payment_term_id']" position="replace"/>
            <xpath expr="//field[@name='pricelist_id']" position="replace"/>
            <!-- Remove references to fields that might not exist -->
            <!--
            <xpath expr="//field[@name='type_id']" position="replace"/>
            <xpath expr="//field[@name='payment_mode_id']" position="replace"/>
            -->

            <!-- Find the "Other Information" tab and add the payment fields there -->
            <xpath expr="//page[@name='other_information']//group" position="inside">
                <!-- Restore the payment fields here -->
                <group name="payment_fields" string="Payment Information">
                    <field name="validity_date" readonly="is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                    <field name="payment_term_id" readonly="is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                    <field name="pricelist_id" readonly="is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                </group>
            </xpath>

            <!-- Hide standard sales fields when is_expedient is True -->
            <xpath expr="//group[1]" position="attributes">
                <attribute name="invisible">is_expedient</attribute>
            </xpath>

            <xpath expr="//group[2]" position="attributes">
                <attribute name="invisible">is_expedient</attribute>
            </xpath>

            <!-- Only show expedient info when is_expedient is True -->
            <xpath expr="//group[1]" position="before">
                <group name="expedient_info" string="Expedient Information"
                       invisible="not is_expedient">
                    <group>
                        <!-- Partner field with standard Odoo address display -->
                        <field name="partner_id" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"
                               widget="res_partner_many2one" context="{'show_address': 1}" options="{'always_reload': True}"/>
                        <field name="partner_invoice_id" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"
                               groups="sale.group_delivery_invoice_address"
                               context="{'default_type':'invoice'}"
                               widget="res_partner_many2one"
                               options="{'show_address': 1}"/>
                        <field name="partner_shipping_id" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"
                               groups="sale.group_delivery_invoice_address"
                               context="{'default_type':'delivery'}"
                               widget="res_partner_many2one"
                               options="{'show_address': 1}"/>
                        <field name="expedient_number" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                        <field name="client_id" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                    </group>
                    <group>
                        <field name="expedient_manager_id" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')" invisible="not is_expedient"/>
                        <field name="expedient_date" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                        <field name="expedient_deadline" readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"/>
                    </group>
                    <!-- Adjust notes field to be more flexible -->
                    <separator string="Notas del expediente"/>
                    <field name="expedient_notes"
                           placeholder="Add detailed notes about this expedient..."
                           readonly="expedient_state in ('aprobada', 'rechazada', 'cancelada')"
                           widget="text"
                           nolabel="1"
                           invisible="not is_expedient" />
                </group>
            </xpath>

            <!-- Remove the original partner_id attributes since we've moved the field -->
            <!--
            <field name="partner_id" position="attributes">
                <attribute name="readonly">is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </field>
            -->

            <field name="date_order" position="attributes">
                <attribute name="readonly">is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </field>

            <field name="fiscal_position_id" position="attributes">
                <attribute name="readonly">is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')</attribute>
            </field>

            <!-- Fix for Odoo 17.0 - Targeting header buttons with proper attributes -->
            <xpath expr="//header/button[@name='action_confirm']" position="attributes">
                <attribute name="invisible" add="is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')" separator=" or "/>
            </xpath>

            <xpath expr="//header/button[@name='action_quotation_send']" position="attributes">
                <attribute name="invisible" add="is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')" separator=" or "/>
            </xpath>

            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible" add="is_expedient and expedient_state in ('aprobada', 'rechazada', 'cancelada')" separator=" or "/>
            </xpath>

            <!-- Remove the warning banner for closed expedients -->
            <xpath expr="//sheet" position="before">
                <!-- Completely remove the warning banner -->
            </xpath>

            <!-- Status bar only for expedients, ensure it's clickable -->
            <xpath expr="//sheet" position="inside">
                <div class="position-absolute top-0 end-0 mt-3 me-3" invisible="not is_expedient">
                    <field name="expedient_state"
                           widget="statusbar"
                           statusbar_visible="creada,pendiente_documentacion,aprobada,rechazada,cancelada"
                           clickable="True"
                           options="{'clickable': '1'}"
                           class="expedient_statusbar"
                           nolabel="1"/>
                </div>
            </xpath>

            <!-- REMOVE THE CUSTOM BUTTONS -->
            <!--
            <xpath expr="//header" position="inside">
                <button string="Approve Expedient"
                        name="action_confirm"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('is_expedient', '=', False), ('expedient_state', 'in', ['aprobada', 'rechazada', 'cancelada'])]}"
                        context="{'set_expedient_state': 'aprobada'}" />

                <button string="Reject Expedient"
                        name="action_confirm"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': ['|', ('is_expedient', '=', False), ('expedient_state', 'in', ['aprobada', 'rechazada', 'cancelada'])]}"
                        context="{'set_expedient_state': 'rechazada'}" />

                <button string="Set Pending Documentation"
                        name="action_expedient_pendiente_documentacion"
                        type="object"
                        class="btn-warning"
                        attrs="{'invisible': ['|', ('is_expedient', '=', False), ('expedient_state', 'in', ['pendiente_documentacion', 'aprobada', 'rechazada', 'cancelada'])]}" />

                <button string="Cancel Expedient"
                        name="action_expedient_cancelada"
                        type="object"
                        class="btn-danger"
                        attrs="{'invisible': ['|', ('is_expedient', '=', False), ('expedient_state', '=', 'cancelada')]}" />
            </xpath>
            -->

            <!-- Update all readonly attributes in expedient_info group -->
            <xpath expr="//group[@name='expedient_info']//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//group[@name='expedient_info']//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//group[@name='expedient_info']//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//group[@name='expedient_info']//field[@name='expedient_number']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//group[@name='expedient_info']//field[@name='client_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//group[@name='expedient_info']//field[@name='expedient_date']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//group[@name='expedient_info']//field[@name='expedient_deadline']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//group[@name='expedient_info']//field[@name='expedient_manager_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//group[@name='expedient_info']//field[@name='expedient_notes']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <!-- REMOVE THE PROBLEMATIC XPATH that references a page that doesn't exist yet -->
            <!-- INSTEAD, modify the returns page at the point where it's created -->
            <xpath expr="//notebook/page[1]" position="before">
                <page name="returns" string="Returns" invisible="not is_expedient">
                    <field name="expedient_return_history_ids"
                           context="{'default_user_id': uid, 'form_view_ref': 'sale_order_expedient.view_expedient_return_history_form'}"
                           readonly="0"
                           style="min-height: 400px; width: 100%;">
                        <tree editable="bottom"
                              create="1"
                              delete="1">
                            <field name="return_date" readonly="0"/>
                            <field name="return_reason_id" options="{'no_create': True}" required="1"/>
                            <field name="notes"/>
                            <field name="user_id" widget="many2one_avatar" force_save="1" readonly="1"/>
                        </tree>
                    </field>
                </page>
            </xpath>

            <!-- Make order lines editable regardless of expedient state -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <!-- Enable create/delete in order lines tree view regardless of expedient state -->
            <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="create">1</attribute>
                <attribute name="delete">1</attribute>
            </xpath>

            <!-- Remove readonly attribute from order line form fields -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <!-- Hide the Order Lines tab when is_expedient is True -->
            <xpath expr="//notebook/page[@name='order_lines']" position="attributes">
                <attribute name="invisible">is_expedient</attribute>
            </xpath>
        </field>
    </record>

    <!-- Create a specific tree view for the history records with better formatting -->
    <record id="view_expedient_return_history_tree" model="ir.ui.view">
        <field name="name">sale.order.expedient.return.history.tree</field>
        <field name="model">sale.order.expedient.return.history</field>
        <field name="arch" type="xml">
            <tree decoration-info="1" editable="bottom" create="true">
                <field name="return_date"/>
                <field name="return_reason_id" options="{'no_create': True}"/>
                <field name="notes"/>
                <field name="user_id" widget="many2one_avatar" readonly="1"/>
            </tree>
        </field>
    </record>

    <!-- Form view for return history with chatter -->
    <record id="view_expedient_return_history_form" model="ir.ui.view">
        <field name="name">sale.order.expedient.return.history.form</field>
        <field name="model">sale.order.expedient.return.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="return_date"/>
                            <field name="return_reason_id" options="{'no_create': True}"/>
                            <field name="user_id" widget="many2one_avatar" readonly="1"/>
                        </group>
                        <group>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search view for expedients with state filters - standalone view instead of inherited -->
    <record id="view_sale_order_expedient_search" model="ir.ui.view">
        <field name="name">sale.order.expedient.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Search Expedients">
                <!-- Standard Sale Order fields -->
                <field name="name" string="Order" filter_domain="[('name','ilike',self)]"/>
                <field name="partner_id" operator="child_of"/>
                <field name="user_id"/>
                <field name="order_line" string="Product" filter_domain="[('order_line.product_id', 'ilike', self)]"/>

                <!-- Expedient specific fields -->
                <field name="client_id"/>
                <field name="expedient_number"/>

                <!-- Filters -->
                <filter string="My Orders" name="my_orders" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Expedients" name="is_expedient" domain="[('is_expedient', '=', True)]"/>
                <separator/>
                <filter string="Created or Pending" name="expedient_state_active"
                       domain="[('expedient_state', 'in', ['creada', 'pendiente_documentacion'])]"/>
                <separator/>
                <filter string="Created" name="expedient_state_creada" domain="[('expedient_state', '=', 'creada')]"/>
                <filter string="Pending Documentation" name="expedient_state_pendiente" domain="[('expedient_state', '=', 'pendiente_documentacion')]"/>
                <filter string="Approved" name="expedient_state_aprobada" domain="[('expedient_state', '=', 'aprobada')]"/>
                <filter string="Rejected" name="expedient_state_rechazada" domain="[('expedient_state', '=', 'rechazada')]"/>
                <filter string="Canceled" name="expedient_state_cancelada" domain="[('expedient_state', '=', 'cancelada')]"/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter string="Salesperson" name="salesperson" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Customer" name="customer" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Client" name="client" domain="[]" context="{'group_by': 'client_id'}"/>
                    <filter string="Expedient State" name="expedient_state_group" domain="[]" context="{'group_by': 'expedient_state'}"/>
                    <filter string="Order Date" name="order_month" domain="[]" context="{'group_by': 'date_order'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista específica para expedientes con botón al lado de la barra de búsqueda -->
    <record id="view_expedient_tree_custom" model="ir.ui.view">
        <field name="name">sale.order.expedient.tree.custom</field>
        <field name="model">sale.order</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree string="Expedientes">
                <control>
                    <create string="New Expedient"/>
                </control>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="expedient_number"/>
                <field name="client_id"/>
                <field name="expedient_manager_id"/>
                <field name="expedient_state" widget="badge"
                       decoration-info="expedient_state == 'creada'"
                       decoration-success="expedient_state == 'aprobada'"
                       decoration-danger="expedient_state == 'rechazada'"
                       decoration-muted="expedient_state == 'cancelada'"
                       decoration-warning="expedient_state == 'pendiente_documentacion'"/>
                <field name="return_count" sum="Total Returns"/>
                <field name="expedient_deadline"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
            </tree>
        </field>
    </record>


    <!-- Actualizar la acción para expedientes -->
    <record id="action_sale_order_expedient" model="ir.actions.act_window">
        <field name="name">Expedientes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_expedient_tree_custom"/>
        <field name="domain">[('is_expedient', '=', True)]</field>
        <field name="context">{'default_is_expedient': True, 'search_default_is_expedient': True, 'search_default_expedient_state_active': 1}</field>
        <field name="search_view_id" ref="view_sale_order_expedient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo expediente
            </p>
        </field>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="binding_type">action</field>
    </record>

    <!-- Add action button for wizard -->
    <record id="action_button_create_expedient_wizard" model="ir.actions.server">
        <field name="name">Wizard</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'name': 'Crear Expediente',
                'res_model': 'expedient.create.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': env.context,
            }
        </field>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Vista tree para expedientes (asegurar que se utiliza esta vista) -->
    <record id="action_expedient_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_expedient_tree_custom"/>
        <field name="act_window_id" ref="action_sale_order_expedient"/>
    </record>

    <!-- Vista form para expedientes (secuencia mayor para que se muestre después) -->
    <record id="action_expedient_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_order_form_expedient"/>
        <field name="act_window_id" ref="action_sale_order_expedient"/>
    </record>

    <!-- Menú para expedientes con la acción configurada -->
    <menuitem id="menu_sale_order_expedient"
              name="Expedientes"
              parent="sale.sale_order_menu"
              action="action_sale_order_expedient"
              sequence="25"/>

    <!-- Update to use the action from the wizard views -->
    <menuitem id="menu_create_expedient"
              name="Nuevo Expediente"
              parent="sale.sale_order_menu"
              action="action_button_create_expedient_wizard"
              sequence="26"/>
</odoo>
