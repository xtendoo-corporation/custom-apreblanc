<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Tree para Pre Paid Expedient -->
    <record id="view_pre_paid_expedient_tree" model="ir.ui.view">
        <field name="name">pre.paid.expedient.tree</field>
        <field name="model">pre.paid.expedient</field>
        <field name="arch" type="xml">
            <tree string="Expedientes Prepagados">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="client_id"/>
                <field name="expedient_number"/>
                <field name="initial_balance"/>
                <field name="current_balance"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'closed'"
                       decoration-warning="state == 'suspended'"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form para Pre Paid Expedient -->
    <record id="view_pre_paid_expedient_form" model="ir.ui.view">
        <field name="name">pre.paid.expedient.form</field>
        <field name="model">pre.paid.expedient</field>
        <field name="arch" type="xml">
            <form string="Expediente Prepagado">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="client_id"/>
                            <field name="expedient_number"/>
                        </group>
                        <group>
                            <field name="initial_balance"/>
                            <field name="current_balance"/>
                            <field name="date_created"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para Pre Paid Expedient -->
    <record id="action_pre_paid_expedient" model="ir.actions.act_window">
        <field name="name">Expedientes Prepagados</field>
        <field name="res_model">pre.paid.expedient</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo expediente prepagado
            </p>
            <p>
                Los expedientes prepagados permiten gestionar saldos prepagados
                que pueden ser utilizados en múltiples órdenes de venta.
            </p>
        </field>
    </record>

    <!-- Menú para Pre Paid Expedient -->
    <menuitem id="menu_pre_paid_expedient"
              name="Expedientes Prepago"
              parent="sale.sale_order_menu"
              action="action_sale_order_prepaid"
              sequence="25"/>
</odoo>
