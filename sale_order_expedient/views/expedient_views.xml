<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree personalizada para Expedientes Post-pagados -->
    <record id="view_expedient_tree_custom" model="ir.ui.view">
        <field name="name">sale.order.expedient.tree.custom</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <tree string="Expedientes Post-pagados">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="create_date" string="Fecha de Creación"/>
                <field name="expedient_start_date" string="Fecha de Inicio"/>
                <field name="expedient_date_end" string="Fecha de Fin"/>
                <field name="expedient_resolution_time" string="Tiempo de Resolución"/>
                <field name="expedient_number"/>
                <field name="client_id"/>
                <field name="complejidad_proyecto"/>
                <field name="numero_personas"/>
                <field name="expedient_manager_id" widget="many2one_avatar"/>
                <field name="is_expedient_admin" invisible="1"/>
                <field name="expedient_state" widget="badge"
                       decoration-info="expedient_state == 'creada'"
                       decoration-success="expedient_state == 'aprobada'"
                       decoration-danger="expedient_state == 'rechazada'"
                       decoration-muted="expedient_state == 'cancelada'"
                       decoration-warning="expedient_state == 'pendiente_documentacion'"/>
                <field name="return_count" sum="Total Returns"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Nueva Vista Pivot para análisis de expedientes mejorada -->
    <record id="view_expedient_pivot" model="ir.ui.view">
        <field name="name">sale.order.expedient.pivot</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Expedientes">
                <!-- Filas: Responsable del expediente como principal -->
                <field name="expedient_manager_id" type="row"/>
                <field name="partner_id" type="row"/>

                <!-- Columnas: Tipo de expediente y estado -->
                <field name="expedient_type" type="col"/>
                <field name="expedient_state" type="col"/>

                <!-- Medidas: Métricas clave -->
                <field name="return_count" type="measure" string="Devoluciones" aggregate="sum"/>
                <field name="numero_personas" type="measure" aggregate="sum"/>
                <field name="amount_total" type="measure" aggregate="sum"/>
            </pivot>
        </field>
    </record>

    <!-- Acción para Expedientes (modificar para incluir ambos tipos) -->
    <record id="action_sale_order_expedient" model="ir.actions.act_window">
        <field name="name">Expedientes</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,pivot,form</field>
        <field name="domain">[('expedient_type', 'in', ['post_paid', 'pre_paid'])]</field>
        <field name="context">{'default_expedient_type': 'post_paid'}</field>
    </record>

    <!-- Elemento de menú para Expedientes Post-pagados -->
    <menuitem id="menu_sale_order_expedient"
              name="Expedientes Post-pagados"
              parent="sale.sale_order_menu"
              action="action_sale_order_expedient"
              sequence="20"/>
</odoo>
