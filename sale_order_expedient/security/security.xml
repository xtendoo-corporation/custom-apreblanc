<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Grupo para administradores de expedientes -->
        <record id="group_expedient_admin" model="res.groups">
            <field name="name">Expedient Administrators</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>

        <!-- Grupo para administradores de plantillas (más información) -->
        <record id="group_template_admin" model="res.groups">
            <field name="name">Template Administrators</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="comment">Users in this group can manage all quotation templates for expedients</field>
        </record>

        <!-- Regla de acceso para expedientes aprobados/rechazados -->
        <record id="expedient_readonly_rule" model="ir.rule">
            <field name="name">Only admins can modify approved/rejected expedients</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[
                '|',
                ('expedient_state', 'not in', ['aprobada', 'rechazada']),
                ('create_uid', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Regla de acceso para administradores -->
        <record id="expedient_admin_rule" model="ir.rule">
            <field name="name">Admins can modify all expedients</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_expedient_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
