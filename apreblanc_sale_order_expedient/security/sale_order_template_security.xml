<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- This category seems unused, but I'll leave it for now. -->
        <record id="group_sale_order_template_rules" model="ir.module.category">
            <field name="name">Sale Order Template Access</field>
            <field name="description">Category for sale order template access</field>
            <field name="sequence">20</field>
        </record>

        <!-- Rule for Expedient Admins to grant full access -->
        <record id="rule_sale_order_template_admin_full_access" model="ir.rule">
            <field name="name">Sale Order Template: Expedient Admin Full Access</field>
            <field name="model_id" ref="sale_management.model_sale_order_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('apreblanc_sale_order_expedient.group_expedient_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- The existing rule, now non-global and applied to general users -->
        <record id="rule_sale_order_template_allowed_groups" model="ir.rule">
            <field name="name">Sale Order Template: Access by Allowed Groups Only</field>
            <field name="model_id" ref="sale_management.model_sale_order_template"/>
            <field name="domain_force">['|', ('allowed_group_ids', '=', False), ('allowed_group_ids', 'in', user.groups_id.ids)]</field>
            <!-- Apply to all authenticated users -->
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
