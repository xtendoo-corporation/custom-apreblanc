<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista del formulario para el nuevo wizard -->
    <record id="view_sale_order_expedient_wizard_form" model="ir.ui.view">
        <field name="name">expedient.create.wizard.form</field>
        <field name="model">expedient.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Expediente">
                <field name="expedient_type" invisible="1"/>
                <field name="partner_readonly" invisible="1"/>
                <field name="show_warning_message" invisible="1"/>
                <field name="show_warning_text_person" invisible="1"/>
                <field name="show_warning_text_numberexp" invisible="1"/>
                <field name="show_warning_text_client" invisible="1"/>
                <!-- Mensaje de advertencia condicional -->
                <div invisible="not show_warning_message" class="alert alert-warning" role="alert">
                    <p invisible="not show_warning_text_person"><strong>Nota:</strong> La persona a estudiar ya pertenece a otro expediente</p>
                    <p invisible="not show_warning_text_numberexp"><strong>Nota:</strong> El número de expediente ya pertenece a otro expediente</p>
                    <p invisible="not show_warning_text_client"><strong>Nota:</strong> El ID de cliente ya pertenece a otro expediente</p>
                </div>
                <group>
                    <field name="sale_order_template_id" options="{'no_create': True}" required="1"/>
                    <field name="partner_id" options="{'no_create': True, 'no_open': True}" readonly="1" force_save="1"/>
                    <field name="client_id"/>
                    <field name="expedient_number"/>
                    <field name="person_under_study"/>
                </group>

                <!-- Mensaje informativo -->
                <div class="alert alert-info" role="alert">
                    <p><strong>Nota:</strong> El cliente se determina automáticamente según la plantilla seleccionada.</p>
                </div>


                <footer>
                    <button string="Crear" name="action_create_expedient" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Nueva acción para abrir el wizard
    <record id="action_sale_order_expedient_wizard" model="ir.actions.act_window">
        <field name="name">Crear Expediente</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order.expedient.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_sale_order_expedient_wizard_form"/>
    </record>
    -->

    <!-- Añadir entrada de menú para la nueva acción
    <menuitem id="menu_sale_order_expedient_wizard"
              name="Crear Expediente"
              parent="sale.sale_order_menu"
              action="action_sale_order_expedient_wizard"
              sequence="10"/>
    -->
</odoo>
