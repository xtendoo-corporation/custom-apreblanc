<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tarea programada para comprobar expedientes sin fecha fin -->
        <record id="ir_cron_check_expedient_end_dates" model="ir.cron">
            <field name="name">Check and Update Missing Expedient End Dates</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_missing_expedient_end_dates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
