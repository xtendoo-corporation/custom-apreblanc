<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Datos iniciales para expedient.return.reason -->

    <record id="return_reason_doc_identification" model="expedient.return.reason">
        <field name="name">Petición de documentación identificativa</field>
        <field name="sequence">10</field>
        <field name="description">Solicitud de documentación para identificar al cliente o persona a estudiar</field>
        <field name="active" eval="True"/>
    </record>

    <record id="return_reason_doc_economic" model="expedient.return.reason">
        <field name="name">Petición de documentación económica</field>
        <field name="sequence">20</field>
        <field name="description">Solicitud de documentación económica adicional</field>
        <field name="active" eval="True"/>
    </record>

    <record id="return_reason_doc_bank" model="expedient.return.reason">
        <field name="name">Petición de documentación bancaria y origen de fondos</field>
        <field name="sequence">30</field>
        <field name="description">Solicitud de información bancaria y justificantes del origen de fondos</field>
        <field name="active" eval="True"/>
    </record>

    <record id="return_reason_data_modification" model="expedient.return.reason">
        <field name="name">Modificación de datos en el aplicativo</field>
        <field name="sequence">40</field>
        <field name="description">Necesidad de modificar datos ya ingresados en el sistema</field>
        <field name="active" eval="True"/>
    </record>

    <record id="return_reason_elevation" model="expedient.return.reason">
        <field name="name">Elevada a SOLVIA/BC/CES</field>
        <field name="sequence">50</field>
        <field name="description">El expediente ha sido elevado para su revisión</field>
        <field name="active" eval="True"/>
    </record>

</odoo>

