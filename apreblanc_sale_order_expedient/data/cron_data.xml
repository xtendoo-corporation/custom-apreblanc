<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron para forzar estado 'sale' en expedientes prepagados -->
        <record id="ir_cron_force_prepaid_sale_state" model="ir.cron">
            <field name="name">Forzar estado 'sale' en expedientes prepagados</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_force_prepaid_sale_state()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>

        <record id="ir_cron_force_prepaid_expedients_sale_state" model="ir.cron">
            <field name="name">Verificar y corregir estados de expedientes prepagados</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.force_prepaid_expedients_sale_state()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
