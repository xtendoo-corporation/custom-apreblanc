<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de búsqueda para expedientes - Heredando la vista de búsqueda de sale.order -->
    <record id="view_sale_order_expedient_search" model="ir.ui.view">
        <field name="name">sale.order.expedient.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <!-- Agregar campos específicos de expediente en la búsqueda -->
            <search position="inside">
                <!-- Campos de búsqueda de expedientes -->
                <field name="expedient_number" string="Número de Expediente" filter_domain="[('expedient_number','ilike',self)]"/>
                <field name="client_id" string="ID Cliente" filter_domain="[('client_id','ilike',self)]"/>
                <field name="person_under_study_id" string="Persona/Entidad Estudiada"/>
                <field name="expedient_manager_id" string="Gestor de Expediente"/>

                <!-- Separador y filtros de estado de expediente -->
                <separator/>
                <filter string="Expedientes Activos" name="expedient_state_active"
                       domain="[('expedient_state', 'in', ['creada', 'pendiente_documentacion'])]"/>
                <filter string="Creados" name="expedient_state_creada" domain="[('expedient_state', '=', 'creada')]"/>
                <filter string="Pendiente Documentación" name="expedient_state_pendiente" domain="[('expedient_state', '=', 'pendiente_documentacion')]"/>
                <filter string="Aprobados" name="expedient_state_aprobada" domain="[('expedient_state', '=', 'aprobada')]"/>
                <filter string="Rechazados" name="expedient_state_rechazada" domain="[('expedient_state', '=', 'rechazada')]"/>
                <filter string="Cancelados" name="expedient_state_cancelada" domain="[('expedient_state', '=', 'cancelada')]"/>
                <separator/>
                <filter string="Post-pagados" name="expedient_type_post" domain="[('expedient_type', '=', 'post_paid')]"/>
                <filter string="Pre-pagados" name="expedient_type_pre" domain="[('expedient_type', '=', 'pre_paid')]"/>
            </search>

            <!-- Agregar opciones de agrupación al grupo existente -->
            <group position="inside">
                <filter string="ID de Cliente" name="client" domain="[]" context="{'group_by': 'client_id'}"/>
                <filter string="Estado del Expediente" name="expedient_state_group" domain="[]" context="{'group_by': 'expedient_state'}"/>
                <filter string="Gestor de Expediente" name="expedient_manager" domain="[]" context="{'group_by': 'expedient_manager_id'}"/>
                <filter string="Tipo de Expediente" name="expedient_type_group" domain="[]" context="{'group_by': 'expedient_type'}"/>
            </group>
        </field>
    </record>
</odoo>
