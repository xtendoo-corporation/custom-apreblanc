<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista heredada simplificada -->
        <record id="view_sale_order_template_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.template.form.inherit</field>
            <field name="model">sale.order.template</field>
            <field name="inherit_id" ref="sale_management.sale_order_template_view_form" />
            <field name="arch" type="xml">
                <!-- Añadir grupo de campos para plantillas de expediente -->
                <xpath expr="//group[1]" position="after">
                    <group string="Configuración de Expediente">
                        <field name="partner_id"
                            options="{'no_create': True}"
                            string="Cliente del Expediente" />
                        <field name="sub_cartera_id"
                            options="{'no_create': True}"
                            string="Sub cartera" />
                        <field name="allowed_group_ids"
                            widget="many2many_tags"
                            options="{'no_create': True}"
                            string="Grupos de Usuarios Autorizados" />
                    </group>
                </xpath>
                <xpath expr="//field[@name='sale_order_template_line_ids']/tree" position="inside">
                    <field name="application_rule" />
                </xpath>
                <xpath expr="//field[@name='sale_order_template_line_ids']/form//group[1]"
                    position="inside">
                    <field name="application_rule" />
                </xpath>
            </field>
        </record>

        <!-- Vista de árbol destacando cliente y grupo para plantillas -->
        <record id="view_sale_order_template_tree_inherit" model="ir.ui.view">
            <field name="name">sale.order.template.tree.inherit</field>
            <field name="model">sale.order.template</field>
            <field name="inherit_id" ref="sale_management.sale_order_template_view_tree" />
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="partner_id" string="Cliente del Expediente" />
                </field>
            </field>
        </record>

        <!-- Acción para abrir plantillas de expedientes -->
        <record id="action_sale_order_expedient_templates" model="ir.actions.act_window">
            <field name="name">Plantillas de Expedientes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.order.template</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea una nueva plantilla para expedientes
                </p>
            </field>
        </record>

        <!-- Menú principal para la configuración de Expedientes -->
        <menuitem id="menu_expedient_configuration"
            name="Expedientes"
            parent="sale.menu_sale_config"
            sequence="39" />

        <!-- Menú para plantillas de expedientes -->
        <menuitem id="menu_sale_order_expedient_templates"
            name="Plantillas"
            parent="menu_expedient_configuration"
            action="action_sale_order_expedient_templates"
            sequence="10" />

        <!-- Vistas para expedient.return.reason -->
        <record id="view_expedient_return_reason_tree" model="ir.ui.view">
            <field name="name">expedient.return.reason.tree</field>
            <field name="model">expedient.return.reason</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name" />
                    <field name="description" />
                    <field name="active" widget="boolean_toggle" />
                </tree>
            </field>
        </record>

        <record id="view_expedient_return_reason_form" model="ir.ui.view">
            <field name="name">expedient.return.reason.form</field>
            <field name="model">expedient.return.reason</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button"
                                icon="fa-archive">
                                <field name="active" widget="boolean_button" />
                            </button>
                        </div>
                        <group>
                            <field name="name" />
                            <field name="description" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción para razones de devolución -->
        <record id="action_expedient_return_reason" model="ir.actions.act_window">
            <field name="name">Return Reasons</field>
            <field name="res_model">expedient.return.reason</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menú para razones de devolución -->
        <menuitem id="menu_expedient_return_reason"
            name="Return Reasons"
            parent="menu_expedient_configuration"
            action="action_expedient_return_reason"
            sequence="50" />

    </data>
</odoo>
