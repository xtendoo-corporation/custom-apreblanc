<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Añadir filtro de búsqueda por tiempo de resolución -->
    <record id="view_sale_order_expedient_search" model="ir.ui.view">
        <field name="name">sale.order.expedient.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <!-- ...existing code... -->
                <group expand="0" string="Group By">
                    <!-- ...existing code... -->
                    <filter string="Estado de Expediente" name="group_expedient_state" context="{'group_by': 'expedient_state'}"/>
                    <filter string="Tiempo de Resolución" name="group_resolution_time" context="{'group_by': 'expedient_resolution_time'}"/>
                    <!-- Se quita el client_id del agrupamiento si existiera -->
                </group>
            </search>
        </field>
    </record>
</odoo>
