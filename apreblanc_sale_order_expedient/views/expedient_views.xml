<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree personalizada para Expedientes Post-pagados -->
    <record id="view_expedient_tree_custom" model="ir.ui.view">
        <field name="name">sale.order.expedient.tree.custom</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <tree string="Expedientes Post-pagados"
                decoration-warning="post_incidencia_activa=='True'">
                <field name="name" />
                <field name="partner_id" />
                <field name="person_under_study" />
                <field name="date_order" />
                <field name="expedient_number" />
                <field name="client_id" />
                <field name="expedient_manager_id" widget="many2one_avatar" />
                <field name="is_expedient_admin" invisible="1" />
                <field name="post_incidencia_activa" invisible="1" />
                <field name="person_under_study" optional="hide" />
                <field name="expedient_state" widget="badge"
                    decoration-info="expedient_state == 'creada'"
                    decoration-success="expedient_state == 'aprobada'"
                    decoration-danger="expedient_state == 'rechazada'"
                    decoration-muted="expedient_state == 'cancelada'"
                    decoration-warning="expedient_state == 'pendiente_documentacion'" />
                <field name="return_count" sum="Total Returns" />
                <field name="expedient_date_end" />
                <field name="expedient_resolution_time" optional="show" />
                <field name="state" />
            </tree>
        </field>
    </record>
    <!-- Acción simple sin vista de búsqueda -->
    <record id="action_sale_order_expedient_simple" model="ir.actions.act_window">
        <field name="name">Expedientes Post-pagados</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_expedient_tree_custom" />
        <field name="domain">[('expedient_type', '=', 'post_paid'), ('expedient_manager_id', '=',
            user.id)]</field>
        <field name="context">{'default_expedient_type': 'post_paid', 'show_as_expedient': True}</field>
    </record>


    <!-- Elemento de menú -->
    <menuitem id="menu_sale_order_expedient"
        name="Expedientes Post-pagados"
        parent="sale.sale_order_menu"
        action="action_sale_order_expedient_simple"
        sequence="20"
        groups="group_expedient_postpago,group_expedient_admin" />
</odoo>