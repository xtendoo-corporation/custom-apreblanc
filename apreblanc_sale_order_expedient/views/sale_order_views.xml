<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista tree para expedientes -->
    <record id="view_sale_order_expedient_tree" model="ir.ui.view">
        <field name="name">sale.order.expedient.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="expedient_type" invisible="1" />
                <field name="expedient_number" optional="show" />
                <field name="client_id" optional="show" />
                <field name="person_under_study" optional="show" />
                <field name="expedient_manager_id" optional="show" widget="many2one_avatar" />
                <field name="date_order" optional="show" string="Fecha de Inicio" />
                <field name="expedient_resolution_time" optional="show"
                    string="Tiempo de Resolución" />
                <field name="expedient_state" optional="show" widget="badge"
                    decoration-info="expedient_state == 'creada'"
                    decoration-success="expedient_state == 'aprobada'"
                    decoration-danger="expedient_state == 'rechazada'"
                    decoration-muted="expedient_state == 'cancelada'" />
                <field name="expedient_date_end" optional="show" />
                <field name="return_count" optional="show" sum="Total Returns" />
            </field>
        </field>
    </record>

    <!-- Update the form view to show date_end instead of deadline -->
    <record id="view_order_form_expedient" model="ir.ui.view">
        <field name="name">sale.order.form.expedient</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="create">false</attribute>
            </form>
            <xpath expr="//header" position="before">
                <widget name="web_ribbon"
                    text="POST-INCIDENCIA"
                    bg_color="text-bg-warning"
                    class="ribbon-top-right"
                    style="z-index: 1000;"
                    invisible="not post_incidencia_activa" />
            </xpath>
            <field name="partner_id" position="after">
                <field name="expedient_type" invisible="1" />
                <field name="expedient_state" invisible="1" />
                <field name="locked" invisible="1" />
                <field name="is_expedient_admin" invisible="1" />
                <field name="post_incidencia_activa" invisible="1" />
            </field>

            <!-- Only move specific fields that we know exist -->
            <xpath expr="//field[@name='validity_date']" position="replace" />
            <xpath expr="//field[@name='payment_term_id']" position="replace" />
            <xpath expr="//field[@name='pricelist_id']" position="replace" />

            <!-- Find the "Other Information" tab and add the payment fields there -->
            <xpath expr="//page[@name='other_information']//group" position="inside">
                <!-- Restore the payment fields here -->
                <group name="payment_fields" string="Payment Information">
                    <field name="validity_date"
                        readonly="expedient_type != 'none' and expedient_state in ('aprobada', 'rechazada', 'cancelada') and not is_expedient_admin" />
                    <field name="payment_term_id"
                        readonly="expedient_type != 'none' and expedient_state in ('aprobada', 'rechazada', 'cancelada') and not is_expedient_admin" />
                    <field name="pricelist_id"
                        readonly="expedient_type != 'none' and expedient_state in ('aprobada', 'rechazada', 'cancelada') and not is_expedient_admin" />
                </group>

                <group name="expedient_valuation" string="Valoración del Expediente"
                    invisible="expedient_type != 'none' and context.get('show_as_expedient', False)">
                    <field name="person_type"
                        required="expedient_type != 'none' and context.get('show_as_expedient', False)"
                        readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin" />
                    <field name="expedient_difficulty"
                        required="expedient_type != 'none' and context.get('show_as_expedient', False)"
                        readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin" />
                    <field name="deadline"
                        required="expedient_type != 'none' and context.get('show_as_expedient', False)"
                        readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin" />
                </group>
            </xpath>

            <!-- Hide standard sales fields when expedient_type is not 'none' -->
            <xpath expr="//group[1]" position="attributes">
                <attribute name="invisible">expedient_type != 'none' and context.get('show_as_expedient', False)</attribute>
            </xpath>

            <xpath expr="//group[2]" position="attributes">
                <attribute name="invisible">expedient_type != 'none' and context.get('show_as_expedient', False)</attribute>
            </xpath>
            <!-- Ocultar header completo para expedientes -->
            <!-- Reemplazar header completo para expedientes -->
            <xpath expr="//header" position="attributes">
                <attribute name="invisible">expedient_type != 'none' and context.get('show_as_expedient', False)</attribute>
            </xpath>

            <xpath expr="//header" position="after">
                <header
                    invisible="expedient_type == 'none' or not context.get('show_as_expedient', False)">
                    <button name="action_set_post_incidencia"
                        type="object"
                        class="btn btn-warning"
                        invisible="expedient_state not in ('aprobada', 'rechazada', 'cancelada')">
                        <span invisible="not post_incidencia_activa">Desactivar Post-incidencia</span>
                        <span invisible="post_incidencia_activa">Post-incidencia</span>
                    </button>
                </header>
            </xpath>

            <!-- Only show expedient info when expedient_type is not 'none' AND show_as_expedient
            context is True -->
            <xpath expr="//group[1]" position="before">
                <group name="expedient_info" string="Información del Expediente"
                    invisible="expedient_type == 'none' or not context.get('show_as_expedient', False)">
                    <group>
                        <!-- Partner field as first field in left column -->
                        <field name="partner_id"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin"
                            widget="res_partner_many2one" context="{'show_address': 1}"
                            options="{'always_reload': True,'no_open': True}" />
                        <field name="person_under_study"
                            required="expedient_type != 'none' and context.get('show_as_expedient', False)"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin" />

                        <field name="client_id"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin" />
                        <field name="expedient_number"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin" />
                        <field name="partner_invoice_id"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin"
                            groups="account.group_delivery_invoice_address"
                            context="{'default_type':'invoice'}"
                            widget="res_partner_many2one"
                            options="{'show_address': 1}" />
                        <field name="partner_shipping_id"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin"
                            groups="account.group_delivery_invoice_address"
                            context="{'default_type':'delivery'}"
                            widget="res_partner_many2one"
                            options="{'show_address': 1}" />
                    </group>
                    <group>
                        <field name="expedient_manager_id"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin"
                            options="{'no_open': True}" />
                        <!-- Fecha de inicio moved to right column -->
                        <field name="date_reception"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin"
                            string="Fecha de Recepción" widget="datetime" />
                        <field name="date_order"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin"
                            string="Fecha de Inicio" widget="datetime" />
                        <field name="expedient_date_end"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin" />
                        <field name="expedient_resolution_time" readonly="1"
                            string="Tiempo de Resolución" />
                        <separator string="Valoración del Expediente" />
                        <field name="person_type"
                            required="expedient_type != 'none' and context.get('show_as_expedient', False)"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin" />
                        <field name="expedient_difficulty"
                            required="expedient_type != 'none' and context.get('show_as_expedient', False)"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin" />
                        <field name="deadline"
                            required="expedient_type != 'none' and context.get('show_as_expedient', False)"
                            readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin" />
                    </group>
                    <!-- Adjust notes field to be more flexible -->
                    <separator string="Notas del expediente" />
                    <field name="expedient_notes"
                        placeholder="Add detailed notes about this expedient..."
                        readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin"
                        widget="text"
                        nolabel="1" />
                </group>
            </xpath>

            <!-- Status bar para expedientes -->
            <xpath expr="//sheet" position="inside">
                <div class="position-absolute top-0 end-0 mt-3 me-3"
                    invisible="expedient_type == 'none' or not context.get('show_as_expedient', False)">
                    <field name="expedient_state"
                        widget="statusbar"
                        statusbar_visible="creada,pendiente_documentacion,aprobada,rechazada,cancelada"
                        clickable="expedient_state not in ['aprobada', 'rechazada'] or is_expedient_admin"
                        options="{'clickable': '1'}"
                        class="expedient_statusbar"
                        nolabel="1" />
                </div>
            </xpath>

            <xpath expr="//notebook/page[1]" position="before">

                <page name="returns" string="Returns"
                    invisible="expedient_type == 'none' or not context.get('show_as_expedient', False)">
                    <field name="expedient_return_history_ids"
                        context="{'default_user_id': uid, 'form_view_ref': 'sale_order_expedient.view_expedient_return_history_form'}"
                        readonly="0">
                        <tree editable="bottom">
                            <field name="return_date" />
                            <field name="return_reason_id" options="{'no_create': True}"
                                required="1" />
                            <field name="notes" />
                            <field name="user_id" widget="many2one_avatar" force_save="1"
                                readonly="1" />
                        </tree>
                    </field>
                </page>

                <!-- Pestaña para la petición -->
                <page name="request" string="Petición"
                    invisible="expedient_type == 'none' or not context.get('show_as_expedient', False)">
                    <field name="request"
                        readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin"
                        placeholder="Detalles de la petición del expediente..."
                        nolabel="1" />
                </page>

                <!-- Pestaña para el resumen -->
                <page name="summary" string="Resumen"
                    invisible="expedient_type == 'none' or not context.get('show_as_expedient', False)">
                    <field name="summary"
                        readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin"
                        placeholder="Resumen del expediente..."
                        nolabel="1" />
                </page>

                <!-- Pestaña para documentoss OneDrive -->
                <page name="onedrive_documents" string="Documentos OneDrive"
                    invisible="expedient_type == 'none' or not context.get('show_as_expedient', False)">
                    <field name="onedrive_document_ids"
                        widget="many2many"
                        nolabel="1"
                        readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin"
                        domain="['|', ('file_url', 'ilike', name), ('name', 'ilike', name)]"
                        options="{'create_text': 'Agregar documento', 'no_open': False}">
                        <tree>
                            <field name="name" />
                            <field name="file_size" />
                            <button name="action_download_file" type="object" string="Descargar"
                                class="btn-primary" />
                        </tree>
                    </field>
                </page>
                <page name="authorization" string="Autorización"
                    invisible="expedient_type == 'none' or not context.get('show_as_expedient', False)">
                    <field name="authorization"
                        readonly="expedient_state in ['aprobada', 'rechazada'] and not is_expedient_admin"
                        placeholder="Detalles de la autorización del expediente..."
                        nolabel="1" />
                </page>

            </xpath>

            <!-- Make order lines editable regardless of expedient state -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <!-- Hide the Order Lines tab when expedient_type is not 'none' AND show_as_expedient is
            True -->
            <xpath expr="//notebook/page[@name='order_lines']" position="attributes">
                <attribute name="invisible">expedient_type != 'none' and context.get('show_as_expedient', False)</attribute>
            </xpath>

            <!-- Hide the Optional Products tab when expedient_type is not 'none' AND
            show_as_expedient is True -->
            <xpath expr="//notebook/page[@name='optional_products']" position="attributes">
                <attribute name="invisible">expedient_type != 'none' and context.get('show_as_expedient', False)</attribute>
            </xpath>

            <!--            &lt;!&ndash; Añadir nuevos campos en la sección de información del expediente
            &ndash;&gt;-->
            <!--            <xpath expr="//group[@name='expedient_info']/group[1]" position="inside">-->
            <!--                <group>-->
            <!--                    <field name="onedrive_document_ids" widget="many2many_tags" options="{'no_create':
            True}" domain="[('is_folder', '=', False)]"/>-->
            <!--                </group>-->
            <!--            </xpath>-->


        </field>
    </record>

    <!-- Vista específica para expedientes con botón al lado de la barra de búsqueda -->
    <record id="view_expedient_tree_custom" model="ir.ui.view">
        <field name="name">sale.order.expedient.tree.custom</field>
        <field name="model">sale.order</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree string="Expedientes Postpago" decoration-danger="post_incidencia_activa"
                decoration-bf="post_incidencia_activa">
                <field name="partner_id" />
                <field name="client_id" />
                <field name="expedient_number" />
                <field name="name" />
                <field name="post_incidencia_activa" invisible="1" />
                <field name="person_under_study" optional="hide" />
                <field name="date_order" string="Fecha de Inicio" />
                <field name="expedient_date_end" />
                <field name="expedient_resolution_time" string="Tiempo de Resolución" />
                <field name="expedient_manager_id" widget="many2one_avatar" />
                <field name="expedient_state" widget="badge"
                    decoration-info="expedient_state == 'creada'"
                    decoration-success="expedient_state == 'aprobada'"
                    decoration-danger="expedient_state == 'rechazada'"
                    decoration-muted="expedient_state == 'cancelada'"
                    decoration-warning="expedient_state in ['pendiente_documentacion']" />
                <field name="deadline" optional="show" />
                <field name="expedient_type" optional="show" />
                <field name="parts_involved" optional="show" />
                <field name="account_numbers" optional="show" />
                <field name="return_count" sum="Total Returns" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <!-- Vista Pivot para análisis de expedientes -->
    <record id="view_sale_order_expedient_pivot" model="ir.ui.view">
        <field name="name">sale.order.expedient.pivot</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Expedientes" display_quantity="true" disable_linking="true">
                <field name="expedient_manager_id" type="row" />
                <field name="expedient_date_end" type="col" />
                <field name="expedient_state" type="col" />
                <field name="parts_involved" type="measure" />
                <field name="account_numbers" type="measure" />
                <field name="amount_total" type="measure" />
                <field name="date_order" interval="month" type="col" />
                <field name="expedient_type" type="row" />
            </pivot>
        </field>
    </record>

    <!-- Actualizar la acción para expedientes para incluir la vista pivot -->
    <record id="action_sale_order_expedient" model="ir.actions.act_window">
        <field name="name">Expedientes Postpago</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="view_id" ref="view_expedient_tree_custom" />
        <field name="domain">[('expedient_type', '=', 'post_paid')]</field>
        <field name="context">{
            'default_expedient_type': 'post_paid',
            'search_default_expedient_state_active': 1,
            'show_as_expedient': True
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo expediente post-pagado
            </p>
        </field>
    </record>

    <!-- Acción específica para la vista pivot -->
    <record id="action_sale_order_expedient_analysis" model="ir.actions.act_window">
        <field name="name">Análisis de Expedientes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_sale_order_expedient_pivot" />
        <field name="domain">[('expedient_type', 'in', ['post_paid', 'pre_paid'])]</field>
        <field name="context">{
            'search_default_expedient_manager_id': 1,
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aquí podrá analizar el rendimiento de los expedientes por responsable
            </p>
        </field>
    </record>

    <!-- Menú para el análisis de expedientes -->
    <menuitem id="menu_sale_order_expedient_analysis"
        name="Análisis de Expedientes"
        parent="sale.menu_sale_report"
        action="action_sale_order_expedient_analysis"
        sequence="30" />

    <!-- Menú para expedientes con la acción configurada -->
    <menuitem id="menu_sale_order_expedient"
        name="Expedientes Postpago"
        parent="sale.sale_order_menu"
        action="action_sale_order_expedient"
        sequence="25"
        groups="group_expedient_postpago,group_expedient_admin" />

    <!-- Vista Tree para Expedientes Pre-pagados (siempre son pedidos de venta) -->
    <record id="view_sale_order_prepaid_tree" model="ir.ui.view">
        <field name="name">sale.order.prepaid.tree</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <tree string="Expedientes Pre-pagados" decoration-danger="post_incidencia_activa"
                decoration-bf="post_incidencia_activa">
                <!-- Nota: Cambiado de "Expedientes Pre-pagados" a "Pedidos de Venta Pre-pagados" -->
                <field name="partner_id" />
                <field name="client_id" />
                <field name="expedient_number" />
                <field name="name" />
                <field name="pre_paid_expedient_id" />
                <field name="date_order" string="Fecha de Inicio" />
                <field name="expedient_date_end" />
                <field name="post_incidencia_activa" invisible="1" />
                <field name="expedient_resolution_time" string="Tiempo de Resolución" />
                <field name="expedient_manager_id" widget="many2one_avatar" />
                <field name="expedient_state"
                    widget="badge"
                    decoration-info="expedient_state == 'creada'"
                    decoration-success="expedient_state == 'aprobada'"
                    decoration-danger="expedient_state == 'rechazada'"
                    decoration-muted="expedient_state == 'cancelada'"
                    decoration-warning="expedient_state in ['pendiente_documentacion']" />
                <field name="expedient_difficulty"
                    widget="badge"
                    decoration-info="expedient_difficulty == 'simple'"
                    decoration-success="expedient_state == 'complex'" />
                <field name="deadline" optional="show" />
                <field name="expedient_type" optional="show" />
                <field name="parts_involved" optional="show" />
                <field name="account_numbers" optional="show" />
                <field name="return_count" sum="Total Returns" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <!-- Acción para Expedientes Pre-pagados -->
    <record id="action_sale_order_prepaid" model="ir.actions.act_window">
        <field name="name">Expedientes Pre-pagados</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_sale_order_prepaid_tree" />
        <field name="domain">[('expedient_type', '=', 'pre_paid'), ('expedient_manager_id', '=',
            uid)]</field>
        <field name="context">{
            'default_expedient_type': 'pre_paid',
            'search_default_expedient_state_active': 1,
            'show_as_expedient': True
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo pedido de venta pre-pagado
            </p>
            <p>
                <b>IMPORTANTE:</b> Los expedientes pre-pagados se convierten automáticamente en
                expedientes confirmados al crearse. No pasan por la fase de presupuesto. </p>
        </field>
    </record>

    <!-- Menú para Expedientes Pre-pagados -->
    <menuitem id="menu_sale_order_prepaid"
        name="Expedientes Pre-pagados"
        parent="sale.sale_order_menu"
        action="action_sale_order_prepaid"
        sequence="25"
        groups="group_expedient_prepago,group_expedient_admin" />

    <!-- Nueva vista y acción para documentos OneDrive -->
    <record id="view_onedrive_document_tree" model="ir.ui.view">
        <field name="name">onedrive.document.tree</field>
        <field name="model">onedrive.document</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="file_size" />
                <button name="action_download_file" type="object" string="Descargar"
                    class="btn-primary" />
            </tree>
        </field>
    </record>

    <record id="action_onedrive_document_tree" model="ir.actions.act_window">
        <field name="name">Documentos OneDrive</field>
        <field name="res_model">onedrive.document</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_onedrive_document_tree" />
        <field name="domain">[('is_folder', '=', False)]</field>
    </record>

    <!-- Restringir menú de Presupuestos solo a administradores de expedientes -->
    <record id="sale.menu_sale_quotations" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_expedient_admin')])]" />
    </record>

    <!-- Restringir menú de Pedidos solo a administradores de expedientes -->
    <record id="sale.menu_sale_order" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_expedient_admin')])]" />
    </record>
</odoo>