<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Rule to hide economic messages from regular users -->
        <record id="rule_hide_economic" model="ir.rule">
            <field name="name">Ocultar mensajes económicos</field>
            <field name="model_id" ref="mail.model_mail_message"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force"
                   eval="['|', ('subtype_id', '=', False), ('subtype_id', '!=', ref('apreblanc_chatter_filter.mt_economic_change'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule to allow users in the economic messages group to see them -->
        <record id="rule_see_economic" model="ir.rule">
            <field name="name">Ver mensajes económicos</field>
            <field name="model_id" ref="mail.model_mail_message"/>
            <field name="groups" eval="[(4, ref('apreblanc_chatter_filter.group_economic_messages'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
