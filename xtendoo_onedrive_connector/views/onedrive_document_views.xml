<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista formulario para crear documentos OneDrive -->
    <record id="view_onedrive_document_form" model="ir.ui.view">
        <field name="name">onedrive.document.form</field>
        <field name="model">onedrive.document</field>
        <field name="arch" type="xml">
            <form string="Documento OneDrive">
                <sheet>
                    <!-- Campos principales para creación -->
                    <group name="main_fields">
                        <!-- Campo de nombre - se llena automáticamente -->
                        <field name="name" placeholder="El nombre se llenará automáticamente al seleccionar el archivo" readonly="context.get('readonly_name', False)"/>

                        <!-- Campo para subir archivo - solo visible al crear -->
                        <field name="file_data"
                               widget="binary"
                               string="Seleccionar Archivo"
                               filename="name"
                               invisible="context.get('hide_upload', False) or id"/>
                    </group>

                    <!-- Información del archivo - solo visible en edición -->
                    <group name="file_info" string="Información del Archivo" invisible="not id">
                        <field name="file_size" readonly="1"/>
                        <field name="file_type" readonly="1"/>
                        <field name="owner" readonly="1"/>
                        <field name="last_modified" readonly="1"/>
                        <field name="file_url" readonly="1" widget="url"/>
                    </group>

                    <!-- Botón de descarga - solo visible en edición -->
                    <div class="oe_button_box" invisible="not id or not file_url">
                        <button name="action_download_file"
                                type="object"
                                string="Descargar Archivo"
                                class="btn-primary"
                                icon="fa-download"/>
                    </div>

                    <!-- Campos técnicos ocultos -->
                    <group invisible="1">
                        <field name="onedrive_id"/>
                        <field name="is_folder"/>
                        <field name="upload_file"/>
                        <field name="upload_filename"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista tree para listar documentos -->
    <record id="view_onedrive_document_tree" model="ir.ui.view">
        <field name="name">onedrive.document.tree</field>
        <field name="model">onedrive.document</field>
        <field name="arch" type="xml">
            <tree string="Documentos OneDrive" __validate__="1">
                <field name="name"/>
                <field name="file_type"/>
                <field name="file_url"/>
                <field name="file_size"/>
                <field name="owner"/>
                <field name="last_modified"/>
                <button name="action_download_file"
                        type="object"
                        string="Descargar"
                        class="btn-primary"
                        invisible="not file_url or is_folder"/>
            </tree>
        </field>
    </record>

    <!-- Vista search para filtrar documentos -->
    <record id="view_onedrive_document_search" model="ir.ui.view">
        <field name="name">onedrive.document.search</field>
        <field name="model">onedrive.document</field>
        <field name="arch" type="xml">
            <search string="Buscar Documentos">
                <field name="name"/>
                <field name="file_type"/>
                <field name="owner"/>
                <separator/>
                <filter string="Solo Archivos" name="files_only" domain="[('is_folder', '=', False)]"/>
                <filter string="Solo Carpetas" name="folders_only" domain="[('is_folder', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo de Archivo" name="group_file_type" context="{'group_by': 'file_type'}"/>
                    <filter string="Propietario" name="group_owner" context="{'group_by': 'owner'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para documentos OneDrive -->
    <record id="action_onedrive_document" model="ir.actions.act_window">
        <field name="name">Documentos OneDrive</field>
        <field name="res_model">onedrive.document</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sube tu primer documento a OneDrive
            </p>
            <p>
                Aquí puedes gestionar todos tus documentos almacenados en OneDrive.
                Los archivos se organizarán automáticamente en carpetas según el proyecto o venta.
            </p>
        </field>
    </record>
</odoo>
