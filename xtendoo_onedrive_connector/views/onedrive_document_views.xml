<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_onedrive_settings_form" model="ir.ui.view">
        <field name="name">onedrive.settings.form</field>
        <field name="model">onedrive.settings</field>
        <field name="arch" type="xml">
            <form string="Configuración OneDrive">
                <group>
                    <field name="onedrive_client_id"/>
                    <field name="onedrive_client_secret" password="True"/>
                    <field name="onedrive_tenant_id"/>
                    <field name="onedrive_redirect_uri"/>
                    <field name="onedrive_refresh_token"/>
                    <button name="action_get_onedrive_auth_url" type="object" string="Obtener URL de autorización OneDrive" class="btn-primary"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_onedrive_settings_tree" model="ir.ui.view">
        <field name="name">onedrive.settings.tree</field>
        <field name="model">onedrive.settings</field>
        <field name="arch" type="xml">
            <tree string="Configuraciones OneDrive">
                <field name="onedrive_client_id"/>
                <field name="onedrive_tenant_id"/>
                <field name="onedrive_redirect_uri"/>
                <field name="onedrive_refresh_token"/>
            </tree>
        </field>
    </record>

    <record id="action_onedrive_settings" model="ir.actions.act_window">
        <field name="name">Configuración OneDrive</field>
        <field name="res_model">onedrive.settings</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_onedrive_settings" name="OneDrive" parent="base.menu_administration" action="action_onedrive_settings" sequence="100"/>

    <!-- Vista tree de documentos OneDrive -->
    <record id="view_onedrive_document_tree" model="ir.ui.view">
        <field name="name">onedrive.document.tree</field>
        <field name="model">onedrive.document</field>
        <field name="arch" type="xml">
            <tree string="Documentos OneDrive" create="true" edit="true">
                <field name="name"/>
                <field name="onedrive_id"/>
                <field name="file_url"/>
                <field name="file_size"/>
                <field name="file_type"/>
                <field name="owner"/>
                <field name="last_modified"/>
                <field name="parent_id"/>
                <field name="is_folder"/>
                <button name="action_sync_onedrive" type="object" string="Sincronizar" class="btn-primary"/>
            </tree>
        </field>
    </record>

    <!-- Vista form de documentos OneDrive -->
    <record id="view_onedrive_document_form" model="ir.ui.view">
        <field name="name">onedrive.document.form</field>
        <field name="model">onedrive.document</field>
        <field name="arch" type="xml">
            <form string="Documento OneDrive">
                <header>
                    <button name="action_sync_onedrive" type="object" string="Sincronizar OneDrive" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="onedrive_id"/>
                        <field name="file_url"/>
                        <field name="file_size"/>
                        <field name="file_type"/>
                        <field name="owner"/>
                        <field name="last_modified"/>
                        <field name="file_data" widget="image" options="{'preview_image': 'file_data'}"/>
                        <xpath expr="//group" position="inside">
                            <div>
                                <t t-if="file_type == 'application/pdf'">
                                    <iframe t-att-src="'/web/content/' + id + '/file_data'" width="100%" height="500px"/>
                                </t>
                                <t t-else="">
                                    <a t-att-href="file_url" target="_blank" class="btn btn-secondary">
                                        Descargar archivo
                                    </a>
                                </t>
                            </div>
                        </xpath>
                        <field name="upload_file"/>
                        <field name="upload_filename"/>
                        <field name="parent_id"/>
                        <field name="is_folder"/>
                    </group>
                    <footer>
                        <button name="action_download_file" type="object" string="Descargar archivo" class="btn-primary"/>
                        <button name="action_upload_file" type="object" string="Subir archivo" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción server para sincronizar (nueva) -->
    <record id="action_onedrive_sync" model="ir.actions.server">
        <field name="name">Sincronizar OneDrive</field>
        <field name="model_id" ref="model_onedrive_document"/>
        <field name="state">code</field>
        <field name="code">action = env['onedrive.document'].action_sync_onedrive()</field>
    </record>

    <record id="action_onedrive_document_window" model="ir.actions.act_window">
        <field name="name">Documentos OneDrive</field>
        <field name="res_model">onedrive.document</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Desde aquí puedes ver, subir, descargar y sincronizar tus archivos y carpetas de OneDrive.</p>
        </field>
    </record>

    <menuitem id="menu_onedrive_root" name="OneDrive" sequence="100"/>
    <menuitem id="menu_onedrive_documents" name="Documentos" parent="menu_onedrive_root" action="action_onedrive_document_window" sequence="10"/>
    <menuitem id="menu_onedrive_sync" name="Sincronizar OneDrive" parent="menu_onedrive_root" action="action_onedrive_sync" sequence="20"/>
</odoo>
