<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista tree para OneDrive Settings -->
    <record id="view_onedrive_settings_tree" model="ir.ui.view">
        <field name="name">onedrive.settings.tree</field>
        <field name="model">onedrive.settings</field>
        <field name="arch" type="xml">
            <tree string="Configuración OneDrive">
                <field name="onedrive_client_id"/>
                <field name="onedrive_tenant_id"/>
                <field name="onedrive_redirect_uri"/>
                <field name="onedrive_sync_folder_name"/>
            </tree>
        </field>
    </record>

    <!-- Vista de formulario independiente para OneDrive Settings -->
    <record id="view_onedrive_settings_form" model="ir.ui.view">
        <field name="name">onedrive.settings.form</field>
        <field name="model">onedrive.settings</field>
        <field name="arch" type="xml">
            <form string="Configuración OneDrive">
                <header>
                    <button name="action_get_onedrive_auth_url" string="Obtener Token de Autorización" type="object" class="btn-primary"/>
                </header>
                <group>
                    <field name="onedrive_client_id"/>
                    <field name="onedrive_client_secret" password="True"/>
                    <field name="onedrive_tenant_id"/>
                    <field name="onedrive_redirect_uri"/>
                    <field name="onedrive_refresh_token"/>
                    <div class="row">
                        <div class="col-12">
                            <label for="onedrive_sync_folder"/>
                            <div class="d-flex align-items-center">
                                <field name="onedrive_sync_folder" placeholder="ID de la carpeta" class="me-2"/>
                                <span class="text-muted" invisible="not onedrive_sync_folder_name">
                                    <i class="fa fa-folder-o me-1"/>
                                    <field name="onedrive_sync_folder_name" readonly="1" class="oe_inline"/>
                                </span>
                            </div>
                            <div class="text-muted" invisible="onedrive_sync_folder">
                                Se usará la carpeta raíz si no se especifica otra.
                            </div>
                        </div>
                    </div>
                </group>
            </form>
        </field>
    </record>

    <!-- Acción para abrir la vista de configuración de OneDrive -->
    <record id="action_onedrive_settings" model="ir.actions.act_window">
        <field name="name">Configuración OneDrive</field>
        <field name="res_model">onedrive.settings</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>
</odoo>
