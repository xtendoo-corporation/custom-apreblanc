<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sube a OneDrive los adjuntos pendientes. Si la opción está desactivada en
             Ajustes OneDrive, no hace nada. -->
        <record id="ir_cron_onedrive_attachment_sync" model="ir.cron">
            <field name="name">OneDrive: subir adjuntos pendientes</field>
            <field name="model_id" ref="model_onedrive_attachment_sync"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_pending()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
