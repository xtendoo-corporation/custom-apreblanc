<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xtendoo_onedrive_connector.OneDrivePreviewWidget">
        <div class="o_onedrive_preview">
            <t t-if="state.isLoading">
                <div class="text-center p-4">
                    <i class="fa fa-spinner fa-spin"/> Cargando previsualización...
                </div>
            </t>
            <t t-elif="!state.previewUrl">
                <div class="alert alert-info text-center">
                    <i class="fa fa-info-circle"/>
                    No hay archivo disponible para previsualizar.
                </div>
            </t>
            <t t-else="">
                <div class="o_onedrive_preview_container">
                    <!-- Botones de acción -->
                    <div class="d-flex justify-content-end mb-2">
                        <button class="btn btn-sm btn-secondary me-2" t-on-click="openInNewWindow">
                            <i class="fa fa-external-link"/> Abrir en nueva ventana
                        </button>
                        <button class="btn btn-sm btn-primary" t-on-click="downloadFile">
                            <i class="fa fa-download"/> Descargar
                        </button>
                    </div>

                    <!-- Previsualización -->
                    <t t-if="state.canEmbedPreview and !state.hasError">
                        <div class="o_onedrive_iframe_container">
                            <iframe
                                t-att-src="state.previewUrl"
                                width="100%"
                                height="600px"
                                style="border: 1px solid #ddd; border-radius: 4px;"
                                t-on-error="onIframeError"
                                sandbox="allow-same-origin allow-scripts allow-popups allow-forms">
                            </iframe>
                        </div>
                    </t>
                    <t t-elif="state.hasError">
                        <div class="alert alert-warning text-center">
                            <i class="fa fa-exclamation-triangle"/>
                            No se pudo cargar la previsualización en el iframe.
                            <br/>
                            <small>El archivo puede estar protegido o ser demasiado grande para previsualizar directamente.</small>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="alert alert-info text-center">
                            <i class="fa fa-file-o"/>
                            <strong t-esc="state.fileName"/>
                            <br/>
                            <small>Este tipo de archivo (<t t-esc="state.fileType"/>) no se puede previsualizar directamente en el navegador.</small>
                            <br/>
                            <small>Usa los botones de arriba para abrir o descargar el archivo.</small>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
