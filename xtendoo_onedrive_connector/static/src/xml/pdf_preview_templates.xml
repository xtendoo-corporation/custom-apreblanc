<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xtendoo_onedrive_connector.PdfPreviewWidget">
        <div class="o_pdf_preview">
            <t t-if="pdfUrl">
                <iframe
                    t-att-src="pdfUrl"
                    width="100%"
                    height="600px"
                    style="border: 1px solid #ddd; border-radius: 4px;">
                </iframe>
            </t>
            <t t-else="">
                <div class="alert alert-warning text-center">
                    No se puede cargar la previsualización del PDF.
                </div>
            </t>
        </div>
    </t>
</templates>

