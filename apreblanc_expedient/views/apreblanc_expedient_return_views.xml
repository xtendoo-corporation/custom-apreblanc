<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_apreblanc_expedient_return_tree" model="ir.ui.view">
        <field name="name">apreblanc.expedient.return.tree</field>
        <field name="model">apreblanc.expedient.return</field>
        <field name="arch" type="xml">
            <tree string="Expedient Returns">
                <field name="expedient_id"/>
                <field name="return_date"/>
                <field name="reason"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_apreblanc_expedient_return_form" model="ir.ui.view">
        <field name="name">apreblanc.expedient.return.form</field>
        <field name="model">apreblanc.expedient.return</field>
        <field name="arch" type="xml">
            <form string="Expedient Return">
                <sheet>
                    <group>
                        <field name="expedient_id"/>
                        <field name="return_date"/>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_apreblanc_expedient_return" model="ir.actions.act_window">
        <field name="name">Expedient Returns</field>
        <field name="res_model">apreblanc.expedient.return</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new expedient return record
            </p>
        </field>
    </record>

    <menuitem id="menu_apreblanc_expedient_return"
              name="Returns"
              parent="menu_apreblanc_expedient_root"
              action="action_apreblanc_expedient_return"
              sequence="2"/>
</odoo>
