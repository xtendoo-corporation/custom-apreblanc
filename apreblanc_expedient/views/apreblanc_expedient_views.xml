<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_apreblanc_expedient_tree" model="ir.ui.view">
        <field name="name">apreblanc.expedient.tree</field>
        <field name="model">apreblanc.expedient</field>
        <field name="arch" type="xml">
            <tree string="Expedients">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="reception_date"/>
                <field name="start_date"/>
                <field name="closing_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_apreblanc_expedient_form" model="ir.ui.view">
        <field name="name">apreblanc.expedient.form</field>
        <field name="model">apreblanc.expedient</field>
        <field name="arch" type="xml">
            <form string="Expedient">
                <header>
                    <button name="action_in_progress" string="Start" type="object" class="oe_highlight" states="draft"/>
                    <button name="action_close" string="Close" type="object" class="oe_highlight" states="in_progress"/>
                    <button name="action_return" string="Return" type="object" states="in_progress,closed"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="reception_date"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="closing_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Returns" name="returns">
                            <field name="expedient_return_ids">
                                <tree editable="bottom">
                                    <field name="return_date"/>
                                    <field name="reason"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_apreblanc_expedient_kanban" model="ir.ui.view">
        <field name="name">apreblanc.expedient.kanban</field>
        <field name="model">apreblanc.expedient</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="reception_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div>
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <div class="text-muted">
                                    <field name="partner_id"/>
                                </div>
                                <div class="text-muted">
                                    <field name="reception_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_apreblanc_expedient_pivot" model="ir.ui.view">
        <field name="name">apreblanc.expedient.pivot</field>
        <field name="model">apreblanc.expedient</field>
        <field name="arch" type="xml">
            <pivot string="Expedients Analysis">
                <field name="partner_id" type="row"/>
                <field name="reception_date" interval="month" type="col"/>
                <field name="__count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_apreblanc_expedient_search" model="ir.ui.view">
        <field name="name">apreblanc.expedient.search</field>
        <field name="model">apreblanc.expedient</field>
        <field name="arch" type="xml">
            <search string="Expedients">
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Closed" name="closed" domain="[('state','=','closed')]"/>
                <filter string="Returned" name="returned" domain="[('state','=','returned')]"/>
                <group expand="0" string="Group By">
                    <filter string="Partner" name="partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Status" name="status" context="{'group_by':'state'}"/>
                    <filter string="Reception Date" name="reception_date" context="{'group_by':'reception_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_apreblanc_expedient" model="ir.actions.act_window">
        <field name="name">Expedients</field>
        <field name="res_model">apreblanc.expedient</field>
        <field name="view_mode">tree,form,kanban,pivot</field>
        <field name="search_view_id" ref="view_apreblanc_expedient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new expedient
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_apreblanc_expedient_root"
              name="Expedients"
              sequence="10"/>

    <menuitem id="menu_apreblanc_expedient"
              name="Expedients"
              parent="menu_apreblanc_expedient_root"
              action="action_apreblanc_expedient"
              sequence="1"/>
</odoo>
