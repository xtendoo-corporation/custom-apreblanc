<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista del Wizard de Exportación -->
        <record id="view_sale_export_wizard_form" model="ir.ui.view">
            <field name="name">sale.export.wizard.form</field>
            <field name="model">sale.export.wizard</field>
            <field name="arch" type="xml">
                <form string="Exportar Todas las Ventas">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="export_filename" invisible="1"/>
                                Exportar Ventas a Excel
                            </h1>
                        </div>
                        <group>
                            <group name="options" string="Opciones de Exportación">
                                <field name="include_order_lines"/>
                                <field name="include_invoices"/>
                            </group>
                        </group>

                        <group name="download_group" invisible="not export_file">
                            <group string="Archivo Generado">
                                <field name="export_file" filename="export_filename" readonly="1"/>
                                <field name="export_filename" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_export_sales" string="Exportar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
