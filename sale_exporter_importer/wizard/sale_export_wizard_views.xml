<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista del Wizard de Exportación -->
        <record id="view_sale_export_wizard_form" model="ir.ui.view">
            <field name="name">sale.export.wizard.form</field>
            <field name="model">sale.export.wizard</field>
            <field name="arch" type="xml">
                <form string="Exportar Todas las Ventas">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="export_filename" invisible="1"/>
                                Exportar Ventas a Excel
                            </h1>
                        </div>
                        <group>
                            <group name="filters" string="Filtros de Exportación">
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="state"/>
                            </group>
                            <group name="options" string="Opciones de Exportación">
                                <field name="include_order_lines"/>
                                <field name="include_invoices"/>
                                <field name="include_payments"/>
                            </group>
                        </group>

                        <group name="download_group" invisible="context.get('default_state') != 'done'">
                            <group string="Archivo Generado">
                                <field name="export_file" filename="export_filename" widget="binary"/>
                                <field name="export_filename" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_export"
                                string="Exportar"
                                type="object"
                                class="btn-primary"
                                invisible="context.get('default_state') == 'done'"/>
                        <button name="action_download"
                                string="Descargar Archivo"
                                type="object"
                                class="btn-primary"
                                invisible="context.get('default_state') != 'done'"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

