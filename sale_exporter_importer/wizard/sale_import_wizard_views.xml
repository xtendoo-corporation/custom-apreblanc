<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista del Wizard de Importación -->
        <record id="view_sale_import_wizard_form" model="ir.ui.view">
            <field name="name">sale.import.wizard.form</field>
            <field name="model">sale.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Importar Todas las Ventas">
                    <sheet>
                        <div class="oe_title">
                            <h1>Importar Ventas desde Excel</h1>
                        </div>
                        <group>
                            <group name="file_group" string="Archivo de Importación">
                                <field name="import_file" filename="import_filename"/>
                                <field name="import_filename"/>
                            </group>
                            <group name="options" string="Opciones de Importación">
                                <field name="update_existing"/>
                                <field name="create_partners"/>
                                <field name="create_products"/>
                            </group>
                        </group>

                        <group name="result_group" invisible="not import_result">
                            <group string="Resultado de la Importación">
                                <field name="import_result" nolabel="1" readonly="1"/>
                            </group>
                        </group>

                        <div class="alert alert-info" role="alert">
                            <strong>Formato del archivo Excel:</strong><br/>
                            El archivo debe contener las siguientes hojas:<br/>
                            • <strong>Ordenes de Venta</strong>: Con columnas: Cliente, Fecha Pedido, Número, etc.<br/>
                            • <strong>Lineas de Pedido</strong>: Con columnas: Número Pedido, Producto, Cantidad, Precio Unitario, etc.<br/>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_import_sales" string="Importar" type="object" class="btn-primary" invisible="import_result"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
