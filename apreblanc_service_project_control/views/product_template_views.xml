<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_apreblanc_service_project" model="ir.ui.view">
        <field name="name">product.template.form.apreblanc.service.project</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="apreblanc_create_service_project" invisible="detailed_type != 'service'"/>
                <field name="apreblanc_target_hours" invisible="detailed_type != 'service' or not apreblanc_create_service_project"/>
            </field>
        </field>
    </record>
</odoo>
