<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_apreblanc_service_project" model="ir.ui.view">
        <field name="name">sale.order.form.apreblanc.service.project</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_apreblanc_service_project"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tasks"
                    invisible="not apreblanc_service_project_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Proyecto operativo</span>
                    </div>
                </button>
            </div>
            <group name="order_details" position="after">
                <group string="Control servicio" invisible="apreblanc_hours_target == 0 and not apreblanc_service_project_id">
                    <field name="apreblanc_service_project_id" readonly="1"/>
                    <field name="apreblanc_hours_target" readonly="1"/>
                    <field name="apreblanc_hours_consumed" readonly="1"/>
                    <field name="apreblanc_hours_remaining" readonly="1"/>
                    <field name="apreblanc_hours_progress" readonly="1"/>
                    <field name="apreblanc_hours_deviation" readonly="1"/>
                    <field name="apreblanc_profitability_pct" readonly="1"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
