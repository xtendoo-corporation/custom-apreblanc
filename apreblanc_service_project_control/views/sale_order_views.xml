<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_apreblanc_service_project" model="ir.ui.view">
        <field name="name">sale.order.form.apreblanc.service.project</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_apreblanc_service_project"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tasks"
                    invisible="not apreblanc_service_project_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Proyecto operativo</span>
                    </div>
                </button>
            </div>
            <page name="order_lines" position="after">
                <page string="Control servicio" name="control_servicio" invisible="apreblanc_hours_target == 0 and not apreblanc_service_project_id">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="d-flex flex-wrap gap-2">
                                <div class="flex-fill">
                                    <span class="o_form_label d-block mb-1">Proyecto operativo</span>
                                    <field name="apreblanc_service_project_id" readonly="1" nolabel="1"/>
                                </div>
                                <div class="flex-fill text-end">
                                    <span class="o_form_label d-block mb-1">Horas presupuestadas</span>
                                    <field name="apreblanc_hours_target" readonly="1" nolabel="1"/>
                                </div>
                                <div class="flex-fill text-end">
                                    <span class="o_form_label d-block mb-1">Horas consumidas</span>
                                    <field name="apreblanc_hours_consumed" readonly="1" nolabel="1"/>
                                </div>
                                <div class="flex-fill text-end">
                                    <span class="o_form_label d-block mb-1">Horas restantes</span>
                                    <field name="apreblanc_hours_remaining" readonly="1" nolabel="1"/>
                                </div>
                                <div class="flex-fill text-end">
                                    <span class="o_form_label d-block mb-1">% consumo</span>
                                    <field name="apreblanc_hours_progress" readonly="1" nolabel="1"/>
                                </div>
                                <div class="flex-fill text-end">
                                    <span class="o_form_label d-block mb-1">Desviación</span>
                                    <field name="apreblanc_hours_deviation" readonly="1" nolabel="1"/>
                                </div>
                                <div class="flex-fill text-end">
                                    <span class="o_form_label d-block mb-1">Rentabilidad estimada %</span>
                                    <field name="apreblanc_profitability_pct" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </page>
            </page>
        </field>
    </record>
</odoo>
