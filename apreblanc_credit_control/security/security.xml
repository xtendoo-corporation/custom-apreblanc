<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_credit_control_apreblanc" model="ir.module.category">
        <field name="name">Control de Crédito Apreblanc</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_credit_control_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_credit_control_apreblanc" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_credit_control_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="category_id" ref="module_category_credit_control_apreblanc" />
        <field name="implied_ids" eval="[(4, ref('group_credit_control_user'))]" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>
</odoo>

