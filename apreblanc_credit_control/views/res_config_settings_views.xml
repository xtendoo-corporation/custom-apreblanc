<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_credit_control_apreblanc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.credit.control.apreblanc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <t groups="apreblanc_credit_control.group_credit_control_manager">
                    <block title="Control de Crédito Apreblanc" id="apreblanc_credit_control">
                        <setting
                            id="apreblanc_credit_debt_limit"
                            string="Límite de deuda vencida"
                            help="Importe mínimo de deuda vencida (en moneda de la empresa) para que un cliente aparezca en el análisis.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label
                                        for="credit_control_debt_limit"
                                        class="col-lg-4 o_light_label"
                                        string="Límite"
                                    />
                                    <field name="credit_control_debt_limit" />
                                </div>
                            </div>
                        </setting>
                    </block>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
