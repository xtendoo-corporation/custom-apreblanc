<odoo>
    <record id="view_order_product_pivot_inherit" model="ir.ui.view">
        <field name="name">sale.report.pivot.inherit</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//pivot" position="inside">
                <!-- Ambos campos definidos como medida -->
                <field name="probability"  type="measure" widget="percentage"/>
                <!--<field name="margin_percent" type="measure" widget="percentage"/> -->
            </xpath>
        </field>
    </record>
</odoo>
